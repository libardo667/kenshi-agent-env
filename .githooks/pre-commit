#!/bin/bash
# Reject new documentation that is neither a decision record nor generated.
#
# Enable in a fresh clone with:
#     git config core.hooksPath .githooks
#
# `tests/test_docs_hygiene.py` enforces the same rule in CI. This hook only
# moves the feedback earlier, so an agent finds out before it writes 400 lines.
set -euo pipefail
# `+(...)` below needs extended globbing; without it the report pattern would
# silently never match and every report would be refused.
shopt -s extglob

edited_reports=$(
  git diff --cached --name-only --diff-filter=MR -- 'docs/REPORT_*.md' || true
)
if [[ -n "$edited_reports" ]]; then
  cat >&2 <<EOF
REPORT documents are write-once. Supersede an existing report by adding a later
dated report; do not modify or rename the earlier record:
$edited_reports
EOF
  exit 1
fi

added=$(git diff --cached --name-only --diff-filter=A -- 'docs/*.md' || true)

stray=""
while IFS= read -r path; do
  [ -n "$path" ] || continue
  case "$path" in
    docs/generated/*) continue ;;
    docs/ADR_*.md) continue ;;
    docs/GUIDE_*.md) continue ;;
    docs/REPORT_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_+([a-z0-9-]).md) continue ;;
    *) stray="$stray  $path"$'\n' ;;
  esac
done <<< "$added"

if [ -n "$stray" ]; then
  cat >&2 <<EOF
pre-commit: refusing new documentation files:
$stray
A new doc must be one of:
  docs/ADR_<TOPIC>.md     a durable decision, one page, superseded not edited
  docs/GUIDE_<TOPIC>.md   a procedure or wire contract, restating no code
  docs/REPORT_<YYYYMMDD>_<topic>.md
                          a dated analysis record, written once, superseded by
                          a later report and never by editing this one
  docs/generated/...      emitted by scripts/export_docs.py

Per-commit evidence belongs in the commit message that proves it. Current-state
description belongs in generated output. Neither belongs in new prose. A report
is for reasoning *across* runs — comparisons, attributions, the argument behind
a design change — which no single commit body can hold.

Override once with: git commit --no-verify
EOF
  exit 1
fi
