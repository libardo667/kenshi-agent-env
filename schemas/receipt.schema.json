{
  "$defs": {
    "ActivateVisibleControlAction": {
      "additionalProperties": false,
      "description": "Activate exactly one control the interface currently advertises.\n\nThe arguments are an exact current label and role, not coordinates: the\nbounds come from telemetry and are re-resolved inside the input lease. The\naction knows nothing about which screen, which conversation, or which option\nindex it is activating.",
      "properties": {
        "kind": {
          "const": "activate_visible_control",
          "default": "activate_visible_control",
          "title": "Kind",
          "type": "string"
        },
        "exact_label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Exact Label",
          "type": "string"
        },
        "role": {
          "default": "button",
          "enum": [
            "button",
            "text",
            "item"
          ],
          "title": "Role",
          "type": "string"
        },
        "window": {
          "default": "",
          "maxLength": 200,
          "title": "Window",
          "type": "string"
        }
      },
      "required": [
        "exact_label"
      ],
      "title": "ActivateVisibleControlAction",
      "type": "object"
    },
    "ApproachDialogueTargetAction": {
      "additionalProperties": false,
      "description": "Walk to one exact currently observed dialogue target and open dialogue.\n\nReusable and target-generic: the target is any current non-hostile person\nthe telemetry already reports as talkable, vendor or not. The action names\nonly a stable observed identity, never a role, a scenario, or a coordinate.\nOne monitored option owns the whole walk, so there is no planner-visible\n\"continue approaching\" command.",
      "properties": {
        "kind": {
          "const": "approach_dialogue_target",
          "default": "approach_dialogue_target",
          "title": "Kind",
          "type": "string"
        },
        "target_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id"
      ],
      "title": "ApproachDialogueTargetAction",
      "type": "object"
    },
    "CalibrationIdentity": {
      "additionalProperties": false,
      "description": "Every fact a profile-calibrated pointer action depends on.\n\nEach field is nullable and a missing value stays missing. A null is never\ntreated as a match, because an unobserved window mode or UI scale is not\nevidence that it is the expected one.",
      "properties": {
        "client_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Width"
        },
        "client_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Height"
        },
        "window_mode": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Mode"
        },
        "ui_scale": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 8.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ui Scale"
        },
        "dpi_scale": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 8.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dpi Scale"
        },
        "keymap_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keymap Id"
        },
        "profile_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Id"
        },
        "profile_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Version"
        },
        "macro_set_hash": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Macro Set Hash"
        }
      },
      "title": "CalibrationIdentity",
      "type": "object"
    },
    "CalibrationReport": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/CalibrationStatus"
        },
        "action_class": {
          "$ref": "#/$defs/PointerActionClass"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/CalibrationIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observed": {
          "anyOf": [
            {
              "$ref": "#/$defs/CalibrationIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mismatched_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Mismatched Fields",
          "type": "array"
        },
        "unobserved_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Unobserved Fields",
          "type": "array"
        }
      },
      "required": [
        "status",
        "action_class",
        "reason"
      ],
      "title": "CalibrationReport",
      "type": "object"
    },
    "CalibrationStatus": {
      "enum": [
        "not_required",
        "matched",
        "mismatched",
        "unknown"
      ],
      "title": "CalibrationStatus",
      "type": "string"
    },
    "ClickAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "click",
          "default": "click",
          "title": "Kind",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "space": {
          "$ref": "#/$defs/CoordinateSpace",
          "default": "normalized"
        },
        "button": {
          "$ref": "#/$defs/MouseButton",
          "default": "left"
        },
        "clicks": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Clicks",
          "type": "integer"
        },
        "hold_seconds": {
          "default": 0.0,
          "maximum": 0.5,
          "minimum": 0.0,
          "title": "Hold Seconds",
          "type": "number"
        },
        "interval_seconds": {
          "default": 0.08,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Interval Seconds",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "ClickAction",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ConditionKind"
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionPath"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operator": {
          "$ref": "#/$defs/ConditionOperator"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "target_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "max_age_seconds": {
          "exclusiveMinimum": 0.0,
          "maximum": 300.0,
          "title": "Max Age Seconds",
          "type": "number"
        },
        "required_capabilities": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Required Capabilities",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "operator",
        "max_age_seconds"
      ],
      "title": "Condition",
      "type": "object"
    },
    "ConditionEvaluation": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "$ref": "#/$defs/Condition"
        },
        "result": {
          "$ref": "#/$defs/ConditionResult"
        },
        "actual": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "condition",
        "result",
        "reason"
      ],
      "title": "ConditionEvaluation",
      "type": "object"
    },
    "ConditionKind": {
      "enum": [
        "field",
        "capability",
        "telemetry_fresh"
      ],
      "title": "ConditionKind",
      "type": "string"
    },
    "ConditionOperator": {
      "enum": [
        "equals",
        "not_equals",
        "less_than",
        "less_than_or_equal",
        "greater_than",
        "greater_than_or_equal",
        "contains"
      ],
      "title": "ConditionOperator",
      "type": "string"
    },
    "ConditionPath": {
      "enum": [
        "control_mode",
        "telemetry_stale",
        "telemetry.game.loaded",
        "telemetry.game.paused",
        "telemetry.game.speed_multiplier",
        "telemetry.game.elapsed_minutes",
        "telemetry.game.money",
        "telemetry.game.location_name",
        "telemetry.game.day",
        "telemetry.game.hour",
        "telemetry.game.minute",
        "telemetry.ui.active_screen",
        "telemetry.ui.modal_open",
        "telemetry.ui.dialogue_open",
        "telemetry.ui.dialogue_target_id",
        "telemetry.ui.dialogue_option_count",
        "telemetry.ui.dialogue_option_0",
        "telemetry.ui.visible_control_count",
        "telemetry.ui.stats_window_open",
        "telemetry.ui.open_inventory_windows",
        "telemetry.ui.management_screen_open",
        "telemetry.ui.management_tab",
        "telemetry.ui.tooltip_visible",
        "telemetry.ui.tooltip_text",
        "telemetry.ui.context_menu_open",
        "telemetry.ui.selected_character_id",
        "telemetry.ui.selected_character_count",
        "telemetry.active_shop_trader_count",
        "telemetry.native_control.available",
        "telemetry.native_control.last_command_sequence",
        "telemetry.native_control.last_command",
        "telemetry.native_control.last_result",
        "telemetry.native_control.last_target",
        "telemetry.native_control.last_target_id",
        "selected.alive",
        "selected.conscious",
        "selected.down",
        "selected.in_combat",
        "selected.position.x",
        "selected.position.y",
        "selected.position.z",
        "selected.movement_speed",
        "selected.hunger",
        "selected.bleeding_rate",
        "selected.food_items",
        "selected.first_aid_kits",
        "selected.current_goal",
        "target.disposition",
        "target.distance",
        "target.visible",
        "target.conscious",
        "target.has_vendor_list",
        "target.is_squad_leader",
        "target.has_dialogue",
        "target.shop_inventory_owner",
        "target.talk_task_available",
        "game.pause",
        "game.speed",
        "game.time",
        "game.money",
        "game.location",
        "camera.position",
        "squad.basic",
        "squad.hunger",
        "squad.health",
        "squad.inventory",
        "ui.modal",
        "ui.inventory",
        "ui.dialogue",
        "ui.dialogue.target",
        "ui.dialogue.options",
        "ui.visible_controls",
        "ui.tooltip",
        "nearby.characters",
        "nearby.visible_entities",
        "nearby.roles",
        "nearby.shop_owners",
        "control.approach_vendor",
        "control.approach_dialogue_target",
        "identity.stable_handles"
      ],
      "title": "ConditionPath",
      "type": "string"
    },
    "ConditionResult": {
      "enum": [
        "true",
        "false",
        "unknown",
        "unavailable",
        "stale"
      ],
      "title": "ConditionResult",
      "type": "string"
    },
    "ControlMode": {
      "enum": [
        "interface_only",
        "native_assisted"
      ],
      "title": "ControlMode",
      "type": "string"
    },
    "CoordinateSpace": {
      "enum": [
        "normalized",
        "client",
        "screen"
      ],
      "title": "CoordinateSpace",
      "type": "string"
    },
    "DismissScreenAction": {
      "additionalProperties": false,
      "description": "Close one bound inventory or trade window toward the world view.\n\nExiting is as much a part of using an interface as entering it. Naming the\nscreen and, where applicable, the owner window makes the action bind to\nobserved state instead of blindly pressing a key and hoping. It deliberately\ndoes not end an active conversation: Kenshi's Escape opens the ESC menu, so\ndialogue must choose an exact visible closing reply.",
      "properties": {
        "kind": {
          "const": "dismiss_screen",
          "default": "dismiss_screen",
          "title": "Kind",
          "type": "string"
        },
        "expected_screen": {
          "enum": [
            "dialogue",
            "trade",
            "inventory"
          ],
          "title": "Expected Screen",
          "type": "string"
        },
        "window": {
          "default": "",
          "maxLength": 200,
          "title": "Window",
          "type": "string"
        }
      },
      "required": [
        "expected_screen"
      ],
      "title": "DismissScreenAction",
      "type": "object"
    },
    "EquipItemAction": {
      "additionalProperties": false,
      "description": "Equip the item in one cell of the selected character's own inventory.\n\nKenshi equips on right-click (`rightClickAutoEquipping`) - the *same*\ngesture that sells an item when a trade is open. That collision is the whole\nhazard: an equip attempted with a shop window up is a sale, and the item is\ngone before any postcondition could notice. So this action refuses outright\nunless no trade is active.",
      "properties": {
        "kind": {
          "const": "equip_item",
          "default": "equip_item",
          "title": "Kind",
          "type": "string"
        },
        "cell_label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Cell Label",
          "type": "string"
        },
        "item_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Item Name",
          "type": "string"
        },
        "window": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Window",
          "type": "string"
        }
      },
      "required": [
        "cell_label",
        "item_name",
        "window"
      ],
      "title": "EquipItemAction",
      "type": "object"
    },
    "GameBinding": {
      "description": "Kenshi's named control intentions under the shipped default keymap.\n\nThe current physical mapping is a hard-coded copy of the shipped\n`controls.cfg`; it is not read from the user's active keymap. Only the\nreversible ones are here: `quicksave`, `quickload`, `editor_toggle`,\n`rebuild_navmesh` and `reload_biomes` all exist in that file and are all\ndeliberately absent from this enum, because an agent running unattended on a\nstream must not be one keystroke away from overwriting a save.",
      "enum": [
        "toggle_inventory",
        "toggle_map",
        "toggle_stats",
        "toggle_help",
        "toggle_crafting",
        "toggle_research",
        "pause",
        "speed_1",
        "speed_2",
        "speed_3",
        "camera_forward",
        "camera_back",
        "camera_left",
        "camera_right",
        "camera_rotate_left",
        "camera_rotate_right",
        "camera_zoom_in",
        "camera_zoom_out",
        "focus_char",
        "select_all",
        "change_squad",
        "character_next",
        "character_prev",
        "stop_movement"
      ],
      "title": "GameBinding",
      "type": "string"
    },
    "HotkeyAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "hotkey",
          "default": "hotkey",
          "title": "Kind",
          "type": "string"
        },
        "keys": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 2,
          "title": "Keys",
          "type": "array"
        },
        "hold_seconds": {
          "default": 0.04,
          "maximum": 5.0,
          "minimum": 0.0,
          "title": "Hold Seconds",
          "type": "number"
        }
      },
      "required": [
        "keys"
      ],
      "title": "HotkeyAction",
      "type": "object"
    },
    "InputBoundaryDecision": {
      "description": "Outcome of the final revalidation performed inside the acquired input lease.",
      "enum": [
        "not_required",
        "revalidated",
        "rejected"
      ],
      "title": "InputBoundaryDecision",
      "type": "string"
    },
    "InputBoundaryReport": {
      "additionalProperties": false,
      "description": "Evidence from the final fence that runs after the input lease is acquired.\n\nValidation performed before a polite input lease can become obsolete while\nthe lease is pending, so a sensitive action revalidates its typed plan\nconditions against the latest canonical revision immediately before the\nfirst primitive is emitted.",
      "properties": {
        "decision": {
          "$ref": "#/$defs/InputBoundaryDecision"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "lease_wait_seconds": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Lease Wait Seconds",
          "type": "number"
        },
        "plan_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Id"
        },
        "plan_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Version"
        },
        "step_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        },
        "validated_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorldStateRevision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "boundary_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorldStateRevision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evaluations": {
          "items": {
            "$ref": "#/$defs/ConditionEvaluation"
          },
          "maxItems": 24,
          "title": "Evaluations",
          "type": "array"
        }
      },
      "required": [
        "decision",
        "reason"
      ],
      "title": "InputBoundaryReport",
      "type": "object"
    },
    "KeyAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "key",
          "default": "key",
          "title": "Kind",
          "type": "string"
        },
        "key": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "hold_seconds": {
          "default": 0.04,
          "maximum": 5.0,
          "minimum": 0.0,
          "title": "Hold Seconds",
          "type": "number"
        }
      },
      "required": [
        "key"
      ],
      "title": "KeyAction",
      "type": "object"
    },
    "MouseButton": {
      "enum": [
        "left",
        "right",
        "middle"
      ],
      "title": "MouseButton",
      "type": "string"
    },
    "MoveCursorAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "move_cursor",
          "default": "move_cursor",
          "title": "Kind",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "space": {
          "$ref": "#/$defs/CoordinateSpace",
          "default": "normalized"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "MoveCursorAction",
      "type": "object"
    },
    "MoveInDirectionAction": {
      "additionalProperties": false,
      "description": "Walk a bearing and a distance from wherever the character is standing.\n\nThe intended destination is a point, not a person, so this action models\nmovement even when no nearby character can serve as a destination. The\ncurrent targetless request is not accepted end to end: the native parser,\nacknowledgement model, and monitored-option adapter still assume a nonempty\ntarget ID.\n\n`bearing_degrees` is clockwise from north, as read on the map: 0 north,\n90 east, 180 south, 270 west.",
      "properties": {
        "kind": {
          "const": "move_in_direction",
          "default": "move_in_direction",
          "title": "Kind",
          "type": "string"
        },
        "bearing_degrees": {
          "exclusiveMaximum": 360.0,
          "minimum": 0.0,
          "title": "Bearing Degrees",
          "type": "number"
        },
        "distance_units": {
          "exclusiveMinimum": 0.0,
          "maximum": 2000.0,
          "title": "Distance Units",
          "type": "number"
        },
        "expected_effect": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Expected Effect",
          "type": "string"
        }
      },
      "required": [
        "bearing_degrees",
        "distance_units",
        "expected_effect"
      ],
      "title": "MoveInDirectionAction",
      "type": "object"
    },
    "MoveToCharacterAction": {
      "additionalProperties": false,
      "description": "Walk to any exact observed nearby character without talking to them.\n\nMovement used to be possible only toward someone the agent could hold a\nconversation with, so inside a building holding two people that was the\nwhole reachable world: it sold what it could, asked both for work, recorded\nthat it was repeating itself, and had no action that could take it\nanywhere. Nearby characters are reported within four hundred units, which\nacross a town is most of it, so walking to a person is how the agent gets\nto a place - the destination is a stable observed identity, never a\ncoordinate.",
      "properties": {
        "kind": {
          "const": "move_to_character",
          "default": "move_to_character",
          "title": "Kind",
          "type": "string"
        },
        "target_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Id",
