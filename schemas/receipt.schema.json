{
  "$defs": {
    "ActivateVisibleControlAction": {
      "additionalProperties": false,
      "description": "Activate exactly one control the interface currently advertises.\n\nThe arguments are an exact current label and role, not coordinates: the\nbounds come from telemetry and are re-resolved inside the input lease. The\naction knows nothing about which screen, which conversation, or which option\nindex it is activating.",
      "properties": {
        "kind": {
          "const": "activate_visible_control",
          "default": "activate_visible_control",
          "title": "Kind",
          "type": "string"
        },
        "exact_label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Exact Label",
          "type": "string"
        },
        "role": {
          "default": "button",
          "enum": [
            "button",
            "text"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "exact_label"
      ],
      "title": "ActivateVisibleControlAction",
      "type": "object"
    },
    "ApproachDialogueTargetAction": {
      "additionalProperties": false,
      "description": "Walk to one exact currently observed dialogue target and open dialogue.\n\nReusable and target-generic: the target is any current non-hostile person\nthe telemetry already reports as talkable, vendor or not. The action names\nonly a stable observed identity, never a role, a scenario, or a coordinate.\nOne monitored option owns the whole walk, so there is no planner-visible\n\"continue approaching\" command.",
      "properties": {
        "kind": {
          "const": "approach_dialogue_target",
          "default": "approach_dialogue_target",
          "title": "Kind",
          "type": "string"
        },
        "target_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id"
      ],
      "title": "ApproachDialogueTargetAction",
      "type": "object"
    },
    "CalibrationIdentity": {
      "additionalProperties": false,
      "description": "Every fact a profile-calibrated pointer action depends on.\n\nEach field is nullable and a missing value stays missing. A null is never\ntreated as a match, because an unobserved window mode or UI scale is not\nevidence that it is the expected one.",
      "properties": {
        "client_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Width"
        },
        "client_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Height"
        },
        "window_mode": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Mode"
        },
        "ui_scale": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 8.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ui Scale"
        },
        "dpi_scale": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 8.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dpi Scale"
        },
        "keymap_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keymap Id"
        },
        "profile_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Id"
        },
        "profile_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Version"
        },
        "macro_set_hash": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Macro Set Hash"
        }
      },
      "title": "CalibrationIdentity",
      "type": "object"
    },
    "CalibrationReport": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/CalibrationStatus"
        },
        "action_class": {
          "$ref": "#/$defs/PointerActionClass"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/CalibrationIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observed": {
          "anyOf": [
            {
              "$ref": "#/$defs/CalibrationIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mismatched_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Mismatched Fields",
          "type": "array"
        },
        "unobserved_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Unobserved Fields",
          "type": "array"
        }
      },
      "required": [
        "status",
        "action_class",
        "reason"
      ],
      "title": "CalibrationReport",
      "type": "object"
    },
    "CalibrationStatus": {
      "enum": [
        "not_required",
        "matched",
        "mismatched",
        "unknown"
      ],
      "title": "CalibrationStatus",
      "type": "string"
    },
    "ClickAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "click",
          "default": "click",
          "title": "Kind",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "space": {
          "$ref": "#/$defs/CoordinateSpace",
          "default": "normalized"
        },
        "button": {
          "$ref": "#/$defs/MouseButton",
          "default": "left"
        },
        "clicks": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Clicks",
          "type": "integer"
        },
        "hold_seconds": {
          "default": 0.0,
          "maximum": 0.5,
          "minimum": 0.0,
          "title": "Hold Seconds",
          "type": "number"
        },
        "interval_seconds": {
          "default": 0.08,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Interval Seconds",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "ClickAction",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ConditionKind"
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionPath"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operator": {
          "$ref": "#/$defs/ConditionOperator"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "target_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "max_age_seconds": {
          "exclusiveMinimum": 0.0,
          "maximum": 300.0,
          "title": "Max Age Seconds",
          "type": "number"
        },
        "required_capabilities": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Required Capabilities",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "operator",
        "max_age_seconds"
      ],
      "title": "Condition",
      "type": "object"
    },
    "ConditionEvaluation": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "$ref": "#/$defs/Condition"
        },
        "result": {
          "$ref": "#/$defs/ConditionResult"
        },
        "actual": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "condition",
        "result",
        "reason"
      ],
      "title": "ConditionEvaluation",
      "type": "object"
    },
    "ConditionKind": {
      "enum": [
        "field",
        "capability",
        "telemetry_fresh"
      ],
      "title": "ConditionKind",
      "type": "string"
    },
    "ConditionOperator": {
      "enum": [
        "equals",
        "not_equals",
        "less_than",
        "less_than_or_equal",
        "greater_than",
        "greater_than_or_equal",
        "contains"
      ],
      "title": "ConditionOperator",
      "type": "string"
    },
    "ConditionPath": {
      "enum": [
        "control_mode",
        "telemetry_stale",
        "telemetry.game.loaded",
        "telemetry.game.paused",
        "telemetry.game.speed_multiplier",
        "telemetry.game.elapsed_minutes",
        "telemetry.game.money",
        "telemetry.game.location_name",
        "telemetry.game.day",
        "telemetry.game.hour",
        "telemetry.game.minute",
        "telemetry.ui.active_screen",
        "telemetry.ui.modal_open",
        "telemetry.ui.dialogue_open",
        "telemetry.ui.dialogue_target_id",
        "telemetry.ui.dialogue_option_count",
        "telemetry.ui.dialogue_option_0",
        "telemetry.ui.visible_control_count",
        "telemetry.ui.tooltip_visible",
        "telemetry.ui.tooltip_text",
        "telemetry.ui.context_menu_open",
        "telemetry.ui.selected_character_id",
        "telemetry.ui.selected_character_count",
        "telemetry.active_shop_trader_count",
        "telemetry.native_control.available",
        "telemetry.native_control.last_command_sequence",
        "telemetry.native_control.last_command",
        "telemetry.native_control.last_result",
        "telemetry.native_control.last_target",
        "telemetry.native_control.last_target_id",
        "selected.alive",
        "selected.conscious",
        "selected.down",
        "selected.in_combat",
        "selected.position.x",
        "selected.position.y",
        "selected.position.z",
        "selected.movement_speed",
        "selected.hunger",
        "selected.bleeding_rate",
        "selected.food_items",
        "selected.first_aid_kits",
        "selected.current_goal",
        "target.disposition",
        "target.distance",
        "target.visible",
        "target.conscious",
        "target.has_vendor_list",
        "target.is_squad_leader",
        "target.has_dialogue",
        "target.shop_inventory_owner",
        "target.talk_task_available",
        "game.pause",
        "game.speed",
        "game.time",
        "game.money",
        "game.location",
        "camera.position",
        "squad.basic",
        "squad.hunger",
        "squad.health",
        "squad.inventory",
        "ui.modal",
        "ui.inventory",
        "ui.dialogue",
        "ui.dialogue.target",
        "ui.dialogue.options",
        "ui.visible_controls",
        "ui.tooltip",
        "nearby.characters",
        "nearby.visible_entities",
        "nearby.roles",
        "nearby.shop_owners",
        "control.approach_vendor",
        "control.approach_dialogue_target",
        "identity.stable_handles"
      ],
      "title": "ConditionPath",
      "type": "string"
    },
    "ConditionResult": {
      "enum": [
        "true",
        "false",
        "unknown",
        "unavailable",
        "stale"
      ],
      "title": "ConditionResult",
      "type": "string"
    },
    "ControlMode": {
      "enum": [
        "interface_only",
        "native_assisted"
      ],
      "title": "ControlMode",
      "type": "string"
    },
    "CoordinateSpace": {
      "enum": [
        "normalized",
        "client",
        "screen"
      ],
      "title": "CoordinateSpace",
      "type": "string"
    },
    "DismissScreenAction": {
      "additionalProperties": false,
      "description": "Close the screen that is currently open, back toward the world view.\n\nExiting is as much a part of using an interface as entering it, and it was\nthe one step with no reusable action: the calibrated path pressed Escape,\na raw key the generic surface rejects for good reason. Naming the screen the\nplanner believes is open makes the action bind to observed state instead of\nblindly pressing a key and hoping.",
      "properties": {
        "kind": {
          "const": "dismiss_screen",
          "default": "dismiss_screen",
          "title": "Kind",
          "type": "string"
        },
        "expected_screen": {
          "enum": [
            "dialogue",
            "trade",
            "inventory"
          ],
          "title": "Expected Screen",
          "type": "string"
        }
      },
      "required": [
        "expected_screen"
      ],
      "title": "DismissScreenAction",
      "type": "object"
    },
    "HotkeyAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "hotkey",
          "default": "hotkey",
          "title": "Kind",
          "type": "string"
        },
        "keys": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 2,
          "title": "Keys",
          "type": "array"
        },
        "hold_seconds": {
          "default": 0.04,
          "maximum": 5.0,
          "minimum": 0.0,
          "title": "Hold Seconds",
          "type": "number"
        }
      },
      "required": [
        "keys"
      ],
      "title": "HotkeyAction",
      "type": "object"
    },
    "InputBoundaryDecision": {
      "description": "Outcome of the final revalidation performed inside the acquired input lease.",
      "enum": [
        "not_required",
        "revalidated",
        "rejected"
      ],
      "title": "InputBoundaryDecision",
      "type": "string"
    },
    "InputBoundaryReport": {
      "additionalProperties": false,
      "description": "Evidence from the final fence that runs after the input lease is acquired.\n\nValidation performed before a polite input lease can become obsolete while\nthe lease is pending, so a sensitive action revalidates its typed plan\nconditions against the latest canonical revision immediately before the\nfirst primitive is emitted.",
      "properties": {
        "decision": {
          "$ref": "#/$defs/InputBoundaryDecision"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "lease_wait_seconds": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Lease Wait Seconds",
          "type": "number"
        },
        "plan_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Id"
        },
        "plan_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Version"
        },
        "step_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        },
        "validated_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorldStateRevision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "boundary_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorldStateRevision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evaluations": {
          "items": {
            "$ref": "#/$defs/ConditionEvaluation"
          },
          "maxItems": 24,
          "title": "Evaluations",
          "type": "array"
        }
      },
      "required": [
        "decision",
        "reason"
      ],
      "title": "InputBoundaryReport",
      "type": "object"
    },
    "KeyAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "key",
          "default": "key",
          "title": "Kind",
          "type": "string"
        },
        "key": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "hold_seconds": {
          "default": 0.04,
          "maximum": 5.0,
          "minimum": 0.0,
          "title": "Hold Seconds",
          "type": "number"
        }
      },
      "required": [
        "key"
      ],
      "title": "KeyAction",
      "type": "object"
    },
    "MouseButton": {
      "enum": [
        "left",
        "right",
        "middle"
      ],
      "title": "MouseButton",
      "type": "string"
    },
    "MoveCursorAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "move_cursor",
          "default": "move_cursor",
          "title": "Kind",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "space": {
          "$ref": "#/$defs/CoordinateSpace",
          "default": "normalized"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "MoveCursorAction",
      "type": "object"
    },
    "NativeCommandAcknowledgement": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "pattern": "^cmd-[0-9a-f]{32}$",
          "title": "Command Id",
          "type": "string"
        },
        "command": {
          "const": "approach_confirmed_vendor",
          "title": "Command",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/NativeCommandStatus"
        },
        "reason": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "target_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "selected_character_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Selected Character Ids",
          "type": "array"
        },
        "based_on_telemetry_sequence": {
          "minimum": 0,
          "title": "Based On Telemetry Sequence",
          "type": "integer"
        },
        "acknowledged_at_telemetry_sequence": {
          "minimum": 0,
          "title": "Acknowledged At Telemetry Sequence",
          "type": "integer"
        },
        "accepted_at_telemetry_sequence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted At Telemetry Sequence"
        },
        "terminal_at_telemetry_sequence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terminal At Telemetry Sequence"
        }
      },
      "required": [
        "command_id",
        "command",
        "status",
        "reason",
        "target_id",
        "selected_character_ids",
        "based_on_telemetry_sequence",
        "acknowledged_at_telemetry_sequence"
      ],
      "title": "NativeCommandAcknowledgement",
      "type": "object"
    },
    "NativeCommandStatus": {
      "enum": [
        "accepted",
        "completed",
        "rejected",
        "cancelled"
      ],
      "title": "NativeCommandStatus",
      "type": "string"
    },
    "NoopAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "noop",
          "default": "noop",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "default": "No action required.",
          "title": "Reason",
          "type": "string"
        }
      },
      "title": "NoopAction",
      "type": "object"
    },
    "NormalizedPointerBounds": {
      "additionalProperties": false,
      "properties": {
        "min_x": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min X",
          "type": "number"
        },
        "max_x": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Max X",
          "type": "number"
        },
        "min_y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Y",
          "type": "number"
        },
        "max_y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Max Y",
          "type": "number"
        }
      },
      "required": [
        "min_x",
        "max_x",
        "min_y",
        "max_y"
      ],
      "title": "NormalizedPointerBounds",
      "type": "object"
    },
    "PauseAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pause",
          "default": "pause",
          "title": "Kind",
          "type": "string"
        },
        "paused": {
          "default": true,
          "title": "Paused",
          "type": "boolean"
        }
      },
      "title": "PauseAction",
      "type": "object"
    },
    "PointerActionClass": {
      "description": "How an action's coordinates are derived, which decides what must match.\n\n`coordinate_independent` actions carry no screen position at all.\n`semantic_current` actions resolve their position from live control,\ntooltip, or entity bounds that are re-read inside the input lease, so they\nsurvive a resolution change. `profile_calibrated` actions replay fixed\nnormalized coordinates and are valid only under one exact identity.",
      "enum": [
        "coordinate_independent",
        "semantic_current",
        "profile_calibrated",
        "unsupported"
      ],
      "title": "PointerActionClass",
      "type": "string"
    },
    "ScrollAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "scroll",
          "default": "scroll",
          "title": "Kind",
          "type": "string"
        },
        "x": {
