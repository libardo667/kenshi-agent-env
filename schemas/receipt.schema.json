    "PointerActionClass": {
      "description": "How an action's coordinates are derived, which decides what must match.\n\n`coordinate_independent` actions carry no screen position at all.\n`semantic_current` actions resolve their position from live control,\ntooltip, or entity bounds that are re-read inside the input lease, so they\nsurvive a resolution change. `profile_calibrated` actions replay fixed\nnormalized coordinates and are valid only under one exact identity.",
      "enum": [
        "coordinate_independent",
        "semantic_current",
        "profile_calibrated",
        "unsupported"
      ],
      "title": "PointerActionClass",
      "type": "string"
    },
    "PurchaseItemAction": {
      "additionalProperties": false,
      "description": "Buy the item in one exact seller-owned cell.\n\nCurrent producers name the cell and item directly. `expected_price` carries\nthe best current value estimate for optional spending gates, but the\nexported `item_value` is base worth rather than an authoritative final shop\ncharge. The action carries no coordinates; exact item, seller, and owner\nbinding prevents the wrong cell from being selected, and a later money\nchange proves the effect.",
      "properties": {
        "kind": {
          "const": "purchase_item",
          "default": "purchase_item",
          "title": "Kind",
          "type": "string"
        },
        "cell_label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Cell Label",
          "type": "string"
        },
        "item_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Item Name",
          "type": "string"
        },
        "expected_price": {
          "exclusiveMinimum": 0,
          "title": "Expected Price",
          "type": "integer"
        },
        "window": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Window",
          "type": "string"
        },
        "seller_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Seller Id",
          "type": "string"
        }
      },
      "required": [
        "cell_label",
        "item_name",
        "expected_price",
        "window",
        "seller_id"
      ],
      "title": "PurchaseItemAction",
      "type": "object"
    },
    "ScrollAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "scroll",
          "default": "scroll",
          "title": "Kind",
