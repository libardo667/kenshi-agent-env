{
  "$defs": {
    "WorldStateRevision": {
      "additionalProperties": false,
      "properties": {
        "telemetry_sequence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Telemetry Sequence"
        },
        "frame_sequence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Sequence"
        },
        "capability_epoch": {
          "default": 0,
          "minimum": 0,
          "title": "Capability Epoch",
          "type": "integer"
        },
        "observed_at_monotonic": {
          "minimum": 0.0,
          "title": "Observed At Monotonic",
          "type": "number"
        }
      },
      "title": "WorldStateRevision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.5",
      "title": "Schema Version",
      "type": "string"
    },
    "command_id": {
      "pattern": "^cmd-[0-9a-f]{32}$",
      "title": "Command Id",
      "type": "string"
    },
    "command": {
      "enum": [
        "continue_game",
        "load_game",
        "new_game",
        "approach_confirmed_vendor",
        "move_to_character",
        "select_squad_member",
        "shift_body_platoon",
        "shift_into_body",
        "regroup_with_squad_member",
        "move_in_direction",
        "travel_to_map_destination",
        "exit_current_building",
        "perform_context_action",
        "perform_character_order",
        "produce_resource_output",
        "transfer_item",
        "open_trade_window",
        "pause",
        "set_speed",
        "close_active_interface",
        "survey_local_resources"
      ],
      "title": "Command",
      "type": "string"
    },
    "control_mode": {
      "const": "native_assisted",
      "title": "Control Mode",
      "type": "string"
    },
    "identity_session_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Identity Session Id",
      "type": "string"
    },
    "based_on_revision": {
      "$ref": "#/$defs/WorldStateRevision"
    },
    "selected_character_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Selected Character Ids",
      "type": "array"
    },
    "target_id": {
      "default": "",
      "maxLength": 200,
      "title": "Target Id",
      "type": "string"
    },
    "context_action": {
      "anyOf": [
        {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        {
          "const": "",
          "type": "string"
        }
      ],
      "default": "",
      "title": "Context Action"
    },
    "bearing_degrees": {
      "default": 0.0,
      "exclusiveMaximum": 360.0,
      "minimum": 0.0,
      "title": "Bearing Degrees",
      "type": "number"
    },
    "distance_units": {
      "default": 0.0,
      "maximum": 2000.0,
      "minimum": 0.0,
      "title": "Distance Units",
      "type": "number"
    },
    "minimum_output_quantity": {
      "default": 1,
      "maximum": 5,
      "minimum": 1,
      "title": "Minimum Output Quantity",
      "type": "integer"
    },
    "destination_id": {
      "default": "",
      "maxLength": 200,
      "title": "Destination Id",
      "type": "string"
    },
    "section_name": {
      "default": "",
      "maxLength": 80,
      "title": "Section Name",
      "type": "string"
    },
    "save_name": {
      "default": "",
      "maxLength": 80,
      "pattern": "^(?:|[A-Za-z0-9][A-Za-z0-9 ._-]{0,79})$",
      "title": "Save Name",
      "type": "string"
    },
    "game_start_id": {
      "default": "",
      "maxLength": 80,
      "pattern": "^(?:|[a-z0-9][a-z0-9-]{0,79})$",
      "title": "Game Start Id",
      "type": "string"
    },
    "slot_x": {
      "default": 0,
      "minimum": 0,
      "title": "Slot X",
      "type": "integer"
    },
    "slot_y": {
      "default": 0,
      "minimum": 0,
      "title": "Slot Y",
      "type": "integer"
    },
    "paused": {
      "default": false,
      "title": "Paused",
      "type": "boolean"
    },
    "speed_multiplier": {
      "default": 0.0,
      "maximum": 1000.0,
      "minimum": 0.0,
      "title": "Speed Multiplier",
      "type": "number"
    },
    "quantity": {
      "default": 0,
      "maximum": 1000,
      "minimum": 0,
      "title": "Quantity",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "command",
    "control_mode",
    "identity_session_id",
    "based_on_revision",
    "selected_character_ids"
  ],
  "title": "NativeCommandRequest",
  "type": "object"
}
