{
  "$defs": {
    "BoundedCollection_ControllerCommandRecord_": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ControllerCommandRecord"
          },
          "maxItems": 256,
          "title": "Items",
          "type": "array"
        },
        "completeness": {
          "$ref": "#/$defs/CollectionCompleteness"
        },
        "known_total": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Known Total"
        }
      },
      "required": [
        "items",
        "completeness",
        "known_total"
      ],
      "title": "BoundedCollection[ControllerCommandRecord]",
      "type": "object"
    },
