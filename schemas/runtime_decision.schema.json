{
  "$defs": {
    "ActionOutcomeEvidence": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "action_outcome",
          "default": "action_outcome",
          "title": "Source",
          "type": "string"
        },
        "outcome_id": {
          "pattern": "^ao-[1-9][0-9]{0,8}$",
          "title": "Outcome Id",
          "type": "string"
        }
      },
      "required": [
        "outcome_id"
      ],
      "title": "ActionOutcomeEvidence",
      "type": "object"
    },
    "AdvisorBriefEvidence": {
      "additionalProperties": false,
      "description": "Advice, not world evidence. Rendered as such wherever it is stored.",
      "properties": {
        "source": {
          "const": "advisor_brief",
          "default": "advisor_brief",
          "title": "Source",
          "type": "string"
        },
        "brief_id": {
          "pattern": "^advisor-[0-9a-f]{32}$",
          "title": "Brief Id",
          "type": "string"
        }
      },
      "required": [
        "brief_id"
      ],
      "title": "AdvisorBriefEvidence",
      "type": "object"
    },
    "AdvisorFocus": {
      "enum": [
        "next_goal",
        "survival",
        "food",
        "economy",
        "recruitment",
        "travel",
        "recovery"
      ],
      "title": "AdvisorFocus",
      "type": "string"
    },
    "AffordanceExecution": {
      "enum": [
        "immediate",
        "monitored",
        "composite"
      ],
      "title": "AffordanceExecution",
      "type": "string"
    },
    "AffordanceParameter": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "AffordanceParameter",
      "type": "object"
    },
    "AffordanceSource": {
      "enum": [
        "runtime",
        "game_binding",
        "visible_control",
        "context_order",
        "dialogue",
        "inventory",
        "squad",
        "nearby_character",
        "map",
        "native_operation",
        "composite_operation"
      ],
      "title": "AffordanceSource",
      "type": "string"
    },
    "AffordanceTarget": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "label",
        "kind"
      ],
      "title": "AffordanceTarget",
      "type": "object"
    },
    "AppendFieldbookEntryOperation": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "append_entry",
          "default": "append_entry",
          "title": "Operation",
          "type": "string"
        },
        "project_id": {
          "pattern": "^fbp-[0-9a-f]{32}$",
          "title": "Project Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FieldbookEntryKind"
        },
        "content": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "references": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/CurrentObservationEvidence"
              },
              {
                "$ref": "#/$defs/ActionOutcomeEvidence"
              },
              {
                "$ref": "#/$defs/PlanOutcomeEvidence"
              },
              {
                "$ref": "#/$defs/MemoryEvidence"
              },
              {
                "$ref": "#/$defs/AdvisorBriefEvidence"
              }
            ]
          },
          "maxItems": 4,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "project_id",
        "kind",
        "content"
      ],
      "title": "AppendFieldbookEntryOperation",
      "type": "object"
    },
    "BoundAffordance": {
      "additionalProperties": false,
      "description": "Runtime provenance retained after an exact affordance selection is compiled.",
      "properties": {
        "affordance_id": {
          "pattern": "^aff-[0-9a-f]{20}$",
          "title": "Affordance Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/AffordanceSource"
        },
        "semantic": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Semantic",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/AffordanceTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/AffordanceParameter"
          },
          "maxItems": 8,
          "title": "Parameters",
          "type": "array"
        },
        "execution": {
          "$ref": "#/$defs/AffordanceExecution"
        },
        "operation_kind": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Operation Kind",
          "type": "string"
        },
        "offered_at_telemetry_sequence": {
          "minimum": 0,
          "title": "Offered At Telemetry Sequence",
          "type": "integer"
        }
      },
      "required": [
        "affordance_id",
        "source",
        "semantic",
        "execution",
        "operation_kind",
        "offered_at_telemetry_sequence"
      ],
      "title": "BoundAffordance",
      "type": "object"
    },
    "CloseActiveInterfaceAction": {
      "additionalProperties": false,
      "description": "Return from the currently blocking interface to the world.\n\nThe action deliberately names no widget, caption, or coordinate. Native\ncode closes the interface families the controller can cause or observe and\nacknowledges success only after Kenshi reports no remaining dialogue,\nmessage box, Prospecting window, inventory pair, or ordinary GUI window.",
      "properties": {
        "kind": {
          "const": "close_active_interface",
          "default": "close_active_interface",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "CloseActiveInterfaceAction",
      "type": "object"
    },
    "ConfirmCharacterEditorAction": {
      "additionalProperties": false,
      "description": "Accept the character currently held in Kenshi's mandatory editor.\n\nRecruitment is not complete when dialogue closes: Kenshi opens this editor\nand withholds the new roster until its exact CONFIRM control is activated.\nNative code dispatches that game-owned semantic event without moving a\npointer or naming a coordinate.",
      "properties": {
        "kind": {
          "const": "confirm_character_editor",
          "default": "confirm_character_editor",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "ConfirmCharacterEditorAction",
      "type": "object"
    },
    "ConsultAdvisorAction": {
      "additionalProperties": false,
      "description": "Ask a read-only guide-grounded model for strategic advice.\n\nThis is a cognitive action. It emits no controller primitives, never enters\nthe environment dispatch path, and cannot directly change Kenshi state.",
      "properties": {
        "kind": {
          "const": "consult_advisor",
          "default": "consult_advisor",
          "title": "Kind",
          "type": "string"
        },
        "question": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "focus": {
          "$ref": "#/$defs/AdvisorFocus",
          "default": "next_goal"
        }
      },
      "required": [
        "question"
      ],
      "title": "ConsultAdvisorAction",
      "type": "object"
    },
    "CreateFieldbookProjectOperation": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_project",
          "default": "create_project",
          "title": "Operation",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FieldbookProjectKind"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "title",
        "summary"
      ],
      "title": "CreateFieldbookProjectOperation",
      "type": "object"
    },
    "CurrentObservationEvidence": {
      "additionalProperties": false,
      "description": "The exact observation the planner was looking at when it wrote this.",
      "properties": {
        "source": {
          "const": "current_observation",
          "default": "current_observation",
          "title": "Source",
          "type": "string"
        }
      },
      "title": "CurrentObservationEvidence",
      "type": "object"
    },
    "FieldbookEntryKind": {
      "enum": [
        "note",
        "decision",
        "observation",
        "incident",
        "manifest",
        "route_entry",
        "expense",
        "question"
      ],
      "title": "FieldbookEntryKind",
      "type": "string"
    },
    "FieldbookProjectKind": {
      "enum": [
        "delivery_docket",
        "route_atlas",
        "incident_log",
        "vendor_ledger",
        "equipment_plan",
        "journal",
        "generic"
      ],
      "title": "FieldbookProjectKind",
      "type": "string"
    },
    "FieldbookProjectStatus": {
      "enum": [
        "active",
        "paused",
        "completed",
        "abandoned"
      ],
      "title": "FieldbookProjectStatus",
      "type": "string"
    },
    "JsonValue": {},
    "KeepMemoryOperation": {
      "additionalProperties": false,
      "description": "Create one durable record from something already established.\n\n`evidence` is absent on purpose. The stored grounding string is rendered by\nthe runtime from `references` after each one resolves, so a record can\nnever describe proof it does not have.",
      "properties": {
        "operation": {
          "const": "keep",
          "default": "keep",
          "title": "Operation",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MemoryKind"
        },
        "content": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "salience": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Salience",
          "type": "number"
        },
        "target_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "references": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/CurrentObservationEvidence"
              },
              {
                "$ref": "#/$defs/ActionOutcomeEvidence"
              },
              {
                "$ref": "#/$defs/PlanOutcomeEvidence"
              },
              {
                "$ref": "#/$defs/MemoryEvidence"
              },
              {
                "$ref": "#/$defs/AdvisorBriefEvidence"
              }
            ]
          },
          "maxItems": 4,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "content"
      ],
      "title": "KeepMemoryOperation",
      "type": "object"
    },
    "MemoryEvidence": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "memory",
          "default": "memory",
          "title": "Source",
          "type": "string"
        },
        "memory_id": {
          "pattern": "^mem-[A-Za-z0-9]{1,72}$",
          "title": "Memory Id",
          "type": "string"
        }
      },
      "required": [
        "memory_id"
      ],
      "title": "MemoryEvidence",
      "type": "object"
    },
    "MemoryKind": {
      "enum": [
        "fact",
        "episode",
        "commitment",
        "hypothesis"
      ],
      "title": "MemoryKind",
      "type": "string"
    },
    "MemoryResolutionDisposition": {
      "description": "What resolving an intention or uncertainty actually concluded.",
      "enum": [
        "completed",
        "abandoned",
        "confirmed",
        "rejected",
        "unknown"
      ],
      "title": "MemoryResolutionDisposition",
      "type": "string"
    },
    "NoopAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "noop",
          "default": "noop",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "default": "No action required.",
          "title": "Reason",
          "type": "string"
        }
      },
      "title": "NoopAction",
      "type": "object"
    },
    "OpenTradeWindowAction": {
      "additionalProperties": false,
      "description": "Put two inventories side by side, in Kenshi's own terms.\n\n`showInventory` opens one window - a character's personal gear, the view a\nplayer gets for stealing - so a transfer opened that way has nothing to move\nbetween. `ForgottenGUI::showTradeWindow` takes both sides and a type, and\nthat type enum is the engine stating that trading and looting are one\nmechanism with a flag rather than two problems.",
      "properties": {
        "kind": {
          "const": "open_trade_window",
          "default": "open_trade_window",
          "title": "Kind",
          "type": "string"
        },
        "first_owner_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "First Owner Id",
          "type": "string"
        },
        "second_owner_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Second Owner Id",
          "type": "string"
        },
        "window_type": {
          "default": "auto",
          "enum": [
            "money_trading",
            "looting",
            "auto"
          ],
          "title": "Window Type",
          "type": "string"
        }
      },
      "required": [
        "first_owner_id",
        "second_owner_id"
      ],
      "title": "OpenTradeWindowAction",
      "type": "object"
    },
    "PauseAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pause",
          "default": "pause",
          "title": "Kind",
          "type": "string"
        },
        "paused": {
          "default": true,
          "title": "Paused",
          "type": "boolean"
        }
      },
      "title": "PauseAction",
      "type": "object"
    },
    "PlanOutcomeEvidence": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "plan_outcome",
          "default": "plan_outcome",
          "title": "Source",
          "type": "string"
        },
        "plan_outcome_id": {
          "pattern": "^po-[1-9][0-9]{0,8}$",
          "title": "Plan Outcome Id",
          "type": "string"
        }
      },
      "required": [
        "plan_outcome_id"
      ],
      "title": "PlanOutcomeEvidence",
      "type": "object"
    },
    "ReadFieldbookAction": {
      "additionalProperties": false,
      "description": "Electively inspect bounded private project context without game input.",
      "properties": {
        "kind": {
          "const": "read_fieldbook",
          "default": "read_fieldbook",
          "title": "Kind",
          "type": "string"
        },
        "project_id": {
          "anyOf": [
            {
              "pattern": "^fbp-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "max_entries": {
          "default": 4,
          "maximum": 8,
          "minimum": 1,
          "title": "Max Entries",
          "type": "integer"
        }
      },
      "title": "ReadFieldbookAction",
      "type": "object"
    },
    "RecallMemoryAction": {
      "additionalProperties": false,
      "description": "Deliberately read continuity beyond what automatic context already showed.\n\nA cognitive action. It emits no controller primitives, never enters the\nenvironment dispatch path, spends no pointer, purchase, or native risk\nbudget, and cannot authorize anything. Durable memory searches active\nrecords; working-outcome searches resurface compact runtime-owned evidence\nthat scrolled out of the rich recent window.",
      "properties": {
        "kind": {
          "const": "recall_memory",
          "default": "recall_memory",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "default": "durable_memory",
          "enum": [
            "durable_memory",
            "working_outcomes"
          ],
          "title": "Source",
          "type": "string"
        },
        "query": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "max_records": {
          "default": 4,
          "maximum": 8,
          "minimum": 1,
          "title": "Max Records",
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "title": "RecallMemoryAction",
      "type": "object"
    },
    "ReinforceMemoryOperation": {
      "additionalProperties": false,
      "description": "Say an existing record still matters, without writing a second copy.",
      "properties": {
        "operation": {
          "const": "reinforce",
          "default": "reinforce",
          "title": "Operation",
          "type": "string"
        },
        "memory_id": {
          "pattern": "^mem-[A-Za-z0-9]{1,72}$",
          "title": "Memory Id",
          "type": "string"
        },
        "salience": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Salience"
        },
        "references": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/CurrentObservationEvidence"
              },
              {
                "$ref": "#/$defs/ActionOutcomeEvidence"
              },
              {
                "$ref": "#/$defs/PlanOutcomeEvidence"
              },
              {
                "$ref": "#/$defs/MemoryEvidence"
              },
              {
                "$ref": "#/$defs/AdvisorBriefEvidence"
              }
            ]
          },
          "maxItems": 4,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "memory_id"
      ],
      "title": "ReinforceMemoryOperation",
      "type": "object"
    },
    "ResolveMemoryOperation": {
      "additionalProperties": false,
      "description": "Close an open commitment or question with the evidence that closed it.",
      "properties": {
        "operation": {
          "const": "resolve",
          "default": "resolve",
          "title": "Operation",
          "type": "string"
        },
        "memory_id": {
          "pattern": "^mem-[A-Za-z0-9]{1,72}$",
          "title": "Memory Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "disposition": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryResolutionDisposition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "references": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/CurrentObservationEvidence"
              },
              {
                "$ref": "#/$defs/ActionOutcomeEvidence"
              },
              {
                "$ref": "#/$defs/PlanOutcomeEvidence"
              },
              {
                "$ref": "#/$defs/MemoryEvidence"
              },
              {
                "$ref": "#/$defs/AdvisorBriefEvidence"
              }
            ]
          },
          "maxItems": 4,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "memory_id",
        "reason"
      ],
      "title": "ResolveMemoryOperation",
      "type": "object"
    },
    "RetractMemoryOperation": {
      "additionalProperties": false,
      "description": "Withdraw a record from active recall without deleting its history.",
      "properties": {
        "operation": {
          "const": "retract",
          "default": "retract",
          "title": "Operation",
          "type": "string"
        },
        "memory_id": {
          "pattern": "^mem-[A-Za-z0-9]{1,72}$",
          "title": "Memory Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "memory_id",
        "reason"
      ],
      "title": "RetractMemoryOperation",
      "type": "object"
    },
    "SelectDialogueOptionAction": {
      "additionalProperties": false,
      "description": "Choose one exact reply from the currently open conversation.\n\nThe index is not trusted alone: the dialogue target and exact rendered\ncaption travel with it, so a reply list that changes between observation\nand dispatch fails closed instead of selecting whatever moved into the old\nrow.",
      "properties": {
        "kind": {
          "const": "select_dialogue_option",
          "default": "select_dialogue_option",
          "title": "Kind",
          "type": "string"
        },
        "dialogue_target_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Dialogue Target Id",
          "type": "string"
        },
        "option_index": {
          "maximum": 63,
          "minimum": 0,
          "title": "Option Index",
          "type": "integer"
        },
        "option_text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Option Text",
          "type": "string"
        }
      },
      "required": [
        "dialogue_target_id",
        "option_index",
        "option_text"
      ],
      "title": "SelectDialogueOptionAction",
      "type": "object"
    },
    "SelectFieldbookProjectOperation": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "select_project",
          "default": "select_project",
          "title": "Operation",
          "type": "string"
        },
        "project_id": {
          "anyOf": [
            {
              "pattern": "^fbp-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        }
      },
      "title": "SelectFieldbookProjectOperation",
      "type": "object"
    },
    "SelectSquadMemberExactAction": {
      "additionalProperties": false,
      "description": "Select one exact squad member through native stable identity.",
      "properties": {
        "kind": {
          "const": "select_squad_member_exact",
          "default": "select_squad_member_exact",
          "title": "Kind",
          "type": "string"
        },
        "target_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id"
      ],
      "title": "SelectSquadMemberExactAction",
      "type": "object"
    },
    "SetFieldbookProjectStatusOperation": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "set_project_status",
          "default": "set_project_status",
          "title": "Operation",
          "type": "string"
        },
        "project_id": {
          "pattern": "^fbp-[0-9a-f]{32}$",
          "title": "Project Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/FieldbookProjectStatus"
        }
      },
      "required": [
        "project_id",
        "status"
      ],
      "title": "SetFieldbookProjectStatusOperation",
      "type": "object"
    },
    "SetSpeedAction": {
      "additionalProperties": false,
      "description": "Set a running playback state at one of Kenshi's three ordinal gears.\n\nThis is one semantic transition even when Kenshi is paused. The controller\nowns starting at gear 1 before selecting a faster gear, because the faster\nkeys do not themselves resume a paused world.",
      "properties": {
        "kind": {
          "const": "set_speed",
          "default": "set_speed",
          "title": "Kind",
          "type": "string"
        },
        "speed": {
          "enum": [
            1,
            2,
            3
          ],
          "title": "Speed",
          "type": "integer"
        }
      },
      "required": [
        "speed"
      ],
      "title": "SetSpeedAction",
      "type": "object"
    },
    "ShiftIntoBodyAction": {
      "additionalProperties": false,
      "description": "Become one exact currently observed character.\n\nControl in Kenshi follows selection rather than roster membership - a\ncharacter released from the active platoon keeps taking orders while absent\nfrom the squad menu - so entering a body means belonging to the player\nfaction and being the selected primary. The body is placed in its own squad:\ninhabiting someone is not gaining a follower, and the bodies left behind\nstay their own unit rather than accumulating into a retinue of former hosts.\n\nThis is the operation that makes a total party loss survivable. It is not\nrestricted to that case, because an agent that can only change bodies while\ndying cannot practise the thing it will need to do while dying.",
      "properties": {
        "kind": {
          "const": "shift_into_body",
          "default": "shift_into_body",
          "title": "Kind",
          "type": "string"
        },
        "target_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id"
      ],
      "title": "ShiftIntoBodyAction",
      "type": "object"
    },
    "StopAction": {
      "additionalProperties": false,
      "description": "End the whole run, not the current plan.\n\nThe distinction is not obvious from the name and was undocumented, so a\nplanner that had finished what it set out to do used this to say \"that\nobjective is complete\" and ended an eighty-step run on step eleven, with a\nreason that read \"resuming free play to pursue next objective\". A plan ends\nby its steps completing; this ends the agent.",
      "properties": {
        "kind": {
          "const": "stop",
          "default": "stop",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "StopAction",
      "type": "object"
    },
    "SupersedeMemoryOperation": {
      "additionalProperties": false,
      "description": "Replace a record and link the old one to its replacement, atomically.",
      "properties": {
        "operation": {
          "const": "supersede",
          "default": "supersede",
          "title": "Operation",
          "type": "string"
        },
        "memory_id": {
          "pattern": "^mem-[A-Za-z0-9]{1,72}$",
          "title": "Memory Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MemoryKind"
        },
        "content": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "salience": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Salience",
          "type": "number"
        },
        "target_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "references": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/CurrentObservationEvidence"
              },
              {
                "$ref": "#/$defs/ActionOutcomeEvidence"
              },
              {
                "$ref": "#/$defs/PlanOutcomeEvidence"
              },
              {
                "$ref": "#/$defs/MemoryEvidence"
              },
              {
                "$ref": "#/$defs/AdvisorBriefEvidence"
              }
            ]
          },
          "maxItems": 4,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "memory_id",
        "kind",
        "content"
      ],
      "title": "SupersedeMemoryOperation",
      "type": "object"
    },
    "SurveyLocalResourcesAction": {
      "additionalProperties": false,
      "description": "Survey Kenshi's resource field where the selected character stands.\n\nThe prospecting reading the game's own window is built from, returned as a\ngrid rather than the single averaged number that window displays. That\naverage is why a zone can report `Iron: 0` while two iron deposits sit in\nit: a discrete node covers a trivial fraction of the surveyed area. A grid\nkeeps direction and distance.\n\nThe planner supplies nothing. Where the character stands is the survey,\nwhich is what makes this an action with a cost rather than free perception.",
      "properties": {
        "kind": {
          "const": "survey_local_resources",
          "default": "survey_local_resources",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "SurveyLocalResourcesAction",
      "type": "object"
    },
    "TransferItemAction": {
      "additionalProperties": false,
      "description": "Move one item between two open inventories, whatever owns them.\n\nLooting a body, buying from a shop, handing something to a squadmate and\nemptying a mining crate are one model-level move with different owners.\nThe plug-in removes the item from the source `Inventory` and tries to add it\nto the destination. When a shop trade is open, the project applies a\ndeliberately simplified price from `Item::getValueSingle`; it does not call\n`InventoryGUI::RClickAutoTrade` or inherit Kenshi's theft, faction-standing,\nstolen-goods, or haggling adjudication.\n\nThe slot is the address. `InventorySection::getItemAt(x, y)` resolves the\nsource item, so `(section_name, slot_x, slot_y)` names it to the model,\nunlike a cell label read off a widget, which names a picture of it.",
      "properties": {
        "kind": {
          "const": "transfer_item",
          "default": "transfer_item",
          "title": "Kind",
          "type": "string"
        },
        "source_owner_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Owner Id",
          "type": "string"
        },
        "destination_owner_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Destination Owner Id",
          "type": "string"
        },
        "section_name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Section Name",
          "type": "string"
        },
        "slot_x": {
          "maximum": 64,
          "minimum": 0,
          "title": "Slot X",
          "type": "integer"
        },
        "slot_y": {
          "maximum": 64,
          "minimum": 0,
          "title": "Slot Y",
          "type": "integer"
        },
        "item_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Item Name",
          "type": "string"
        }
      },
      "required": [
        "source_owner_id",
        "destination_owner_id",
        "section_name",
        "slot_x",
        "slot_y",
        "item_name"
      ],
      "title": "TransferItemAction",
      "type": "object"
    },
    "UpdateFieldbookSummaryOperation": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "update_summary",
          "default": "update_summary",
          "title": "Operation",
          "type": "string"
