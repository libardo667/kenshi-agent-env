{
  "$defs": {
    "ActivateVisibleControlAction": {
      "additionalProperties": false,
      "description": "Activate exactly one control the interface currently advertises.\n\nThe arguments are an exact current label and role, not coordinates: the\nbounds come from telemetry and are re-resolved inside the input lease. The\naction knows nothing about which screen, which conversation, or which option\nindex it is activating.",
      "properties": {
        "kind": {
          "const": "activate_visible_control",
          "default": "activate_visible_control",
          "title": "Kind",
          "type": "string"
        },
        "exact_label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Exact Label",
          "type": "string"
        },
        "role": {
          "default": "button",
          "enum": [
            "button",
            "text",
            "item"
          ],
          "title": "Role",
          "type": "string"
        },
        "window": {
          "default": "",
          "maxLength": 200,
          "title": "Window",
          "type": "string"
        }
      },
      "required": [
        "exact_label"
      ],
      "title": "ActivateVisibleControlAction",
      "type": "object"
    },
    "AdvisorFocus": {
      "enum": [
        "next_goal",
        "survival",
        "food",
        "economy",
        "recruitment",
        "travel",
        "recovery"
      ],
      "title": "AdvisorFocus",
      "type": "string"
    },
    "AffordanceUrgency": {
      "enum": [
        "survival_critical",
        "blocks_current_goal",
        "improves_fidelity"
      ],
      "title": "AffordanceUrgency",
      "type": "string"
    },
    "ApproachDialogueTargetAction": {
      "additionalProperties": false,
      "description": "Initiate dialogue with one exact currently observed dialogue target.\n\nReusable and target-generic: the target is any current non-hostile person\nthe telemetry already reports as talkable, vendor or not. The action names\nonly a stable observed identity, never a role, a scenario, or a coordinate.\nThe controller issues Kenshi's native talk-to order and owns the whole\nmonitored interaction, so there is no planner-visible \"continue\napproaching\" or prerequisite unpause command.",
      "properties": {
        "kind": {
          "const": "approach_dialogue_target",
          "default": "approach_dialogue_target",
          "title": "Kind",
          "type": "string"
        },
        "target_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id"
      ],
      "title": "ApproachDialogueTargetAction",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ConditionKind"
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionPath"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operator": {
          "$ref": "#/$defs/ConditionOperator"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "target_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "max_age_seconds": {
          "exclusiveMinimum": 0.0,
          "maximum": 300.0,
          "title": "Max Age Seconds",
          "type": "number"
        },
        "required_capabilities": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Required Capabilities",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "operator",
        "max_age_seconds"
      ],
      "title": "Condition",
      "type": "object"
    },
    "ConditionKind": {
      "enum": [
        "field",
        "capability",
        "telemetry_fresh"
      ],
      "title": "ConditionKind",
      "type": "string"
    },
    "ConditionOperator": {
      "enum": [
        "equals",
        "not_equals",
        "less_than",
        "less_than_or_equal",
        "greater_than",
        "greater_than_or_equal",
        "contains"
      ],
      "title": "ConditionOperator",
      "type": "string"
    },
    "ConditionPath": {
      "enum": [
        "control_mode",
        "telemetry_stale",
        "telemetry.game.loaded",
        "telemetry.game.paused",
        "telemetry.game.speed_multiplier",
        "telemetry.game.elapsed_minutes",
        "telemetry.game.money",
        "selected.indoors",
        "telemetry.game.location_name",
        "telemetry.game.day",
        "telemetry.game.hour",
        "telemetry.game.minute",
        "telemetry.ui.active_screen",
        "telemetry.ui.modal_open",
        "telemetry.ui.dialogue_open",
        "telemetry.ui.dialogue_target_id",
        "telemetry.ui.dialogue_option_count",
        "telemetry.ui.dialogue_option_0",
        "telemetry.ui.visible_control_count",
        "telemetry.ui.stats_window_open",
        "telemetry.ui.open_inventory_windows",
        "telemetry.ui.management_screen_open",
        "telemetry.ui.management_tab",
        "telemetry.ui.tooltip_visible",
        "telemetry.ui.tooltip_text",
        "telemetry.ui.context_menu_open",
        "telemetry.ui.selected_character_id",
        "telemetry.ui.selected_character_count",
        "telemetry.active_shop_trader_count",
        "telemetry.native_control.available",
        "telemetry.native_control.command_active",
        "telemetry.native_control.last_command_sequence",
        "telemetry.native_control.last_command",
        "telemetry.native_control.last_result",
        "telemetry.native_control.last_target",
        "telemetry.native_control.last_target_id",
        "selected.alive",
        "selected.conscious",
        "selected.down",
        "selected.in_combat",
        "selected.position.x",
        "selected.position.y",
        "selected.position.z",
        "selected.movement_speed",
        "selected.hunger",
        "selected.bleeding_rate",
        "selected.food_items",
        "selected.first_aid_kits",
        "selected.current_goal",
        "target.disposition",
        "target.distance",
        "target.visible",
        "target.conscious",
        "target.has_vendor_list",
        "target.is_squad_leader",
        "target.has_dialogue",
        "target.shop_inventory_owner",
        "game.pause",
        "game.speed",
        "game.time",
        "game.money",
        "game.location",
        "camera.position",
        "squad.basic",
        "squad.hunger",
        "squad.health",
        "squad.inventory",
        "squad.current_goal",
        "ui.modal",
        "ui.inventory",
        "ui.dialogue",
        "ui.dialogue.target",
        "ui.dialogue.options",
        "ui.visible_controls",
        "ui.tooltip",
        "nearby.characters",
        "nearby.visible_entities",
        "nearby.roles",
        "nearby.shop_owners",
        "control.approach_vendor",
        "control.approach_dialogue_target",
        "identity.stable_handles"
      ],
      "title": "ConditionPath",
      "type": "string"
    },
    "ConsultAdvisorAction": {
      "additionalProperties": false,
      "description": "Ask a read-only guide-grounded model for strategic advice.\n\nThis is a cognitive action. It emits no controller primitives, never enters\nthe environment dispatch path, and cannot directly change Kenshi state.",
      "properties": {
        "kind": {
          "const": "consult_advisor",
          "default": "consult_advisor",
          "title": "Kind",
          "type": "string"
        },
        "question": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "focus": {
          "$ref": "#/$defs/AdvisorFocus",
          "default": "next_goal"
        }
      },
      "required": [
        "question"
      ],
      "title": "ConsultAdvisorAction",
      "type": "object"
    },
    "ContextActionKind": {
      "description": "A reviewed semantic action an exact world object accepts as an attempt.",
      "enum": [
        "operate"
      ],
      "title": "ContextActionKind",
      "type": "string"
    },
    "DismissScreenAction": {
      "additionalProperties": false,
      "description": "Close one bound inventory or trade window toward the world view.\n\nExiting is as much a part of using an interface as entering it. Naming the\nscreen and, where applicable, the owner window makes the action bind to\nobserved state instead of blindly pressing a key and hoping. It deliberately\ndoes not end an active conversation: Kenshi's Escape opens the ESC menu, so\ndialogue must choose an exact visible closing reply.",
      "properties": {
        "kind": {
          "const": "dismiss_screen",
          "default": "dismiss_screen",
          "title": "Kind",
          "type": "string"
        },
        "expected_screen": {
          "enum": [
            "dialogue",
            "trade",
            "inventory"
          ],
          "title": "Expected Screen",
          "type": "string"
        },
        "window": {
          "default": "",
          "maxLength": 200,
          "title": "Window",
          "type": "string"
        }
      },
      "required": [
        "expected_screen"
      ],
      "title": "DismissScreenAction",
      "type": "object"
    },
    "EquipItemAction": {
      "additionalProperties": false,
      "description": "Equip the item in one cell of the selected character's own inventory.\n\nKenshi equips on right-click (`rightClickAutoEquipping`) - the *same*\ngesture that sells an item when a trade is open. That collision is the whole\nhazard: an equip attempted with a shop window up is a sale, and the item is\ngone before any postcondition could notice. So this action refuses outright\nunless no trade is active.",
      "properties": {
        "kind": {
          "const": "equip_item",
          "default": "equip_item",
          "title": "Kind",
          "type": "string"
        },
        "cell_label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Cell Label",
          "type": "string"
        },
        "item_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Item Name",
          "type": "string"
        },
        "window": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Window",
          "type": "string"
        }
      },
      "required": [
        "cell_label",
        "item_name",
        "window"
      ],
      "title": "EquipItemAction",
      "type": "object"
    },
    "ExitCurrentBuildingAction": {
      "additionalProperties": false,
      "description": "Leave the selected character's current building through a native door.\n\nThe planner supplies no coordinates, bearing, door identity, or retry\nstrategy. The native controller resolves an unlocked door from the exact\nbuilding the selected character currently occupies, issues one pathing\norder to its outdoor point, and owns completion or typed failure.",
      "properties": {
        "kind": {
          "const": "exit_current_building",
          "default": "exit_current_building",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "ExitCurrentBuildingAction",
      "type": "object"
    },
    "GameBinding": {
      "description": "Kenshi's named control intentions under the shipped default keymap.\n\nThe current physical mapping is a hard-coded copy of the shipped\n`controls.cfg`; it is not read from the user's active keymap. Only the\nreversible ones are here: `quicksave`, `quickload`, `editor_toggle`,\n`rebuild_navmesh` and `reload_biomes` all exist in that file and are all\ndeliberately absent from this enum, because an agent running unattended on a\nstream must not be one keystroke away from overwriting a save.",
      "enum": [
        "toggle_inventory",
        "toggle_map",
        "toggle_stats",
        "toggle_help",
        "toggle_crafting",
        "toggle_research",
        "pause",
        "speed_1",
        "speed_2",
        "speed_3",
        "camera_forward",
        "camera_back",
        "camera_left",
        "camera_right",
        "camera_rotate_left",
        "camera_rotate_right",
        "camera_zoom_in",
        "camera_zoom_out",
        "focus_char",
        "select_all",
        "change_squad",
        "character_next",
        "character_prev",
        "stop_movement"
      ],
      "title": "GameBinding",
      "type": "string"
    },
    "IdempotencyPolicy": {
      "enum": [
        "at_most_once",
        "safe_to_retry"
      ],
      "title": "IdempotencyPolicy",
      "type": "string"
    },
    "InterruptPolicy": {
      "enum": [
        "cancel_on_reflex",
        "cancel_on_reflex_or_plan_patch"
      ],
      "title": "InterruptPolicy",
      "type": "string"
    },
    "MemoryKind": {
      "enum": [
        "fact",
        "episode",
        "commitment",
        "hypothesis"
      ],
      "title": "MemoryKind",
      "type": "string"
    },
    "MemoryWrite": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/MemoryKind"
        },
        "content": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "salience": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Salience",
          "type": "number"
        },
        "evidence": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        }
      },
      "required": [
        "kind",
        "content"
      ],
      "title": "MemoryWrite",
      "type": "object"
    },
    "MoveInDirectionAction": {
      "additionalProperties": false,
      "description": "Walk a bearing and a distance from wherever the character is standing.\n\nThe intended destination is a point, not a person, so this action models\nmovement even when no nearby character can serve as a destination. Its\nnative request and acknowledgement deliberately carry an empty target ID;\ncommand identity is the keyed command, selected character, bearing, and\ndistance.\n\n`bearing_degrees` is clockwise from north, as read on the map: 0 north,\n90 east, 180 south, 270 west.",
      "properties": {
        "kind": {
          "const": "move_in_direction",
          "default": "move_in_direction",
          "title": "Kind",
          "type": "string"
        },
        "bearing_degrees": {
          "exclusiveMaximum": 360.0,
          "minimum": 0.0,
          "title": "Bearing Degrees",
          "type": "number"
        },
        "distance_units": {
          "exclusiveMinimum": 0.0,
          "maximum": 2000.0,
          "title": "Distance Units",
          "type": "number"
        },
        "expected_effect": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Expected Effect",
          "type": "string"
        }
      },
      "required": [
        "bearing_degrees",
        "distance_units",
        "expected_effect"
      ],
      "title": "MoveInDirectionAction",
      "type": "object"
    },
    "MoveToCharacterAction": {
      "additionalProperties": false,
      "description": "Walk to any exact observed nearby character without talking to them.\n\nMovement used to be possible only toward someone the agent could hold a\nconversation with, so inside a building holding two people that was the\nwhole reachable world: it sold what it could, asked both for work, recorded\nthat it was repeating itself, and had no action that could take it\nanywhere. Nearby characters are reported within four hundred units, which\nacross a town is most of it, so walking to a person is how the agent gets\nto a place - the destination is a stable observed identity, never a\ncoordinate.",
      "properties": {
        "kind": {
          "const": "move_to_character",
          "default": "move_to_character",
          "title": "Kind",
          "type": "string"
        },
        "target_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id"
      ],
      "title": "MoveToCharacterAction",
      "type": "object"
    },
    "NoopAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "noop",
          "default": "noop",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "default": "No action required.",
          "title": "Reason",
          "type": "string"
        }
      },
      "title": "NoopAction",
      "type": "object"
    },
    "ObservationPolicy": {
      "enum": [
        "after_action",
        "until_terminal"
      ],
      "title": "ObservationPolicy",
      "type": "string"
    },
    "PauseAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pause",
          "default": "pause",
          "title": "Kind",
          "type": "string"
        },
        "paused": {
          "default": true,
          "title": "Paused",
          "type": "boolean"
        }
      },
      "title": "PauseAction",
      "type": "object"
    },
    "PerformContextAction": {
      "additionalProperties": false,
      "description": "Perform one exact contextual task an observed world object advertises.\n\nThe planner copies only a `(target_id, context_action)` pair from current\n`context_targets`. Native code re-resolves the object, rechecks the reviewed\ntask, issues Kenshi's own default order, and proves the selected character's\nAI accepted that exact object/task pair.",
      "properties": {
        "kind": {
          "const": "perform_context_action",
          "default": "perform_context_action",
          "title": "Kind",
          "type": "string"
        },
        "target_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "context_action": {
          "$ref": "#/$defs/ContextActionKind"
        }
      },
      "required": [
        "target_id",
        "context_action"
      ],
      "title": "PerformContextAction",
      "type": "object"
    },
    "PlanStep": {
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Step Id",
          "type": "string"
        },
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/NoopAction"
            },
            {
              "$ref": "#/$defs/StopAction"
            },
            {
              "$ref": "#/$defs/PauseAction"
            },
            {
              "$ref": "#/$defs/SetSpeedAction"
            },
            {
              "$ref": "#/$defs/WaitAction"
            },
            {
              "$ref": "#/$defs/ConsultAdvisorAction"
            },
            {
              "$ref": "#/$defs/RequestAffordanceAction"
            },
            {
              "$ref": "#/$defs/ApproachDialogueTargetAction"
            },
            {
              "$ref": "#/$defs/PerformContextAction"
            },
            {
              "$ref": "#/$defs/MoveToCharacterAction"
            },
            {
              "$ref": "#/$defs/MoveInDirectionAction"
            },
            {
              "$ref": "#/$defs/ExitCurrentBuildingAction"
            },
            {
              "$ref": "#/$defs/ActivateVisibleControlAction"
            },
            {
              "$ref": "#/$defs/DismissScreenAction"
            },
            {
              "$ref": "#/$defs/PurchaseItemAction"
            },
            {
              "$ref": "#/$defs/UseGameBindingAction"
            },
            {
              "$ref": "#/$defs/ScrollScreenAction"
            },
            {
              "$ref": "#/$defs/SellItemAction"
            },
            {
              "$ref": "#/$defs/EquipItemAction"
            },
            {
              "$ref": "#/$defs/RecoverCameraViewAction"
            },
            {
              "$ref": "#/$defs/SkillAction"
            }
          ],
          "title": "Action"
        },
        "preconditions": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Preconditions",
          "type": "array"
        },
        "success_conditions": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "maxItems": 12,
          "title": "Success Conditions",
          "type": "array"
        },
        "failure_conditions": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "maxItems": 12,
          "title": "Failure Conditions",
          "type": "array"
        },
        "timeout_seconds": {
          "exclusiveMinimum": 0.0,
          "maximum": 60.0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "retry_budget": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Retry Budget",
          "type": "integer"
        },
        "idempotency": {
          "$ref": "#/$defs/IdempotencyPolicy",
          "default": "at_most_once"
        },
        "on_success": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Success"
        },
        "on_failure": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Failure"
        },
        "interrupt_policy": {
          "$ref": "#/$defs/InterruptPolicy",
          "default": "cancel_on_reflex"
        },
        "observation_policy": {
          "$ref": "#/$defs/ObservationPolicy",
          "default": "until_terminal"
        }
      },
      "required": [
        "step_id",
        "action",
        "preconditions",
        "timeout_seconds"
      ],
      "title": "PlanStep",
      "type": "object"
    },
    "PurchaseItemAction": {
      "additionalProperties": false,
      "description": "Buy the item in one exact seller-owned cell.\n\nCurrent producers name the cell and item directly. `expected_price` carries\nthe best current value estimate for optional spending gates, but the\nexported `item_value` is base worth rather than an authoritative final shop\ncharge. The action carries no coordinates; exact item, seller, and owner\nbinding prevents the wrong cell from being selected, and a later money\nchange proves the effect.",
      "properties": {
        "kind": {
          "const": "purchase_item",
          "default": "purchase_item",
          "title": "Kind",
          "type": "string"
        },
        "cell_label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Cell Label",
          "type": "string"
        },
        "item_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Item Name",
          "type": "string"
        },
        "expected_price": {
          "exclusiveMinimum": 0,
          "title": "Expected Price",
          "type": "integer"
        },
        "window": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Window",
          "type": "string"
        },
        "seller_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Seller Id",
          "type": "string"
        }
      },
      "required": [
        "cell_label",
        "item_name",
        "expected_price",
        "window",
        "seller_id"
      ],
      "title": "PurchaseItemAction",
      "type": "object"
    },
    "RecoverCameraViewAction": {
      "additionalProperties": false,
      "description": "Ask the controller to restore a usable character-following world view.\n\nThis action intentionally has no camera parameters. The caller identifies\nthe problem; the controller owns the bounded follow, floor, zoom, orbit,\ncapture, and scoring transaction and reports its terminal outcome.",
      "properties": {
        "kind": {
          "const": "recover_camera_view",
          "default": "recover_camera_view",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "RecoverCameraViewAction",
      "type": "object"
    },
    "RequestAffordanceAction": {
      "additionalProperties": false,
      "description": "Retain a concrete capability gap without emitting game input.\n\nThis is a cognitive action, like consulting the advisor. It tells the\nengineering loop which intention the current action surface cannot express;\nit does not grant that capability or authorize an improvised substitute.",
      "properties": {
        "kind": {
          "const": "request_affordance",
          "default": "request_affordance",
          "title": "Kind",
          "type": "string"
        },
        "capability": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "blocked_goal": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Blocked Goal",
          "type": "string"
        },
        "why_needed": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Why Needed",
          "type": "string"
        },
        "evidence": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "available_workaround": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available Workaround"
        },
        "urgency": {
          "$ref": "#/$defs/AffordanceUrgency",
          "default": "blocks_current_goal"
        }
      },
      "required": [
        "capability",
        "blocked_goal",
        "why_needed",
        "evidence"
      ],
      "title": "RequestAffordanceAction",
      "type": "object"
    },
    "ScrollScreenAction": {
      "additionalProperties": false,
      "description": "Scroll inside one open window so more of its contents become visible.\n\nShops and inventories hold more than fits on screen, and the export only\never describes what is currently rendered. Without this, stock past the\nfirst screenful is not merely hard to reach - it does not exist as far as\nthe agent is concerned, and no amount of replanning reveals it.\n\nNames a window rather than a coordinate: the scroll lands at the centre of\nthat window's own observed bounds, so it follows the window and survives a\nresolution change.",
      "properties": {
        "kind": {
          "const": "scroll_screen",
          "default": "scroll_screen",
          "title": "Kind",
          "type": "string"
        },
        "window": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Window",
          "type": "string"
        },
        "notches": {
          "maximum": 8,
          "minimum": -8,
          "title": "Notches",
          "type": "integer"
        }
      },
      "required": [
        "window",
        "notches"
      ],
      "title": "ScrollScreenAction",
      "type": "object"
    },
    "SellItemAction": {
      "additionalProperties": false,
      "description": "Sell the item in one exact cell of the agent's own inventory.\n\nThe mirror of `purchase_item`, and the reason trading stopped being one-way:\nwith only a purchase action the agent could spend its starting money and\nthen never earn any.\n\nDeliberately carries no expected price. A shop pays its own multiplier on an\nitem's value rather than the listed value, and that offer is not exported,\nso asserting a price here would be asserting something we cannot check - the\nexact failure mode `purchase_item` was built to avoid. What *is* checked is\nthat the cell is in this character's own inventory and holds this item.",
      "properties": {
        "kind": {
          "const": "sell_item",
          "default": "sell_item",
          "title": "Kind",
          "type": "string"
        },
        "cell_label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Cell Label",
          "type": "string"
        },
        "item_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Item Name",
          "type": "string"
        },
        "window": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Window",
          "type": "string"
        },
        "buyer_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Buyer Id",
          "type": "string"
        }
      },
      "required": [
        "cell_label",
        "item_name",
        "window",
        "buyer_id"
      ],
      "title": "SellItemAction",
      "type": "object"
    },
    "SetSpeedAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "set_speed",
          "default": "set_speed",
          "title": "Kind",
          "type": "string"
        },
        "speed": {
          "enum": [
            1,
            2,
            3
          ],
          "title": "Speed",
          "type": "integer"
        }
      },
      "required": [
        "speed"
      ],
      "title": "SetSpeedAction",
      "type": "object"
    },
    "SkillAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "skill",
          "default": "skill",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "args": {
          "items": {
            "$ref": "#/$defs/SkillArgument"
          },
          "maxItems": 20,
          "title": "Args",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "SkillAction",
      "type": "object"
    },
    "SkillArgument": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "SkillArgument",
      "type": "object"
    },
    "StopAction": {
      "additionalProperties": false,
      "description": "End the whole run, not the current plan.\n\nThe distinction is not obvious from the name and was undocumented, so a\nplanner that had finished what it set out to do used this to say \"that\nobjective is complete\" and ended an eighty-step run on step eleven, with a\nreason that read \"resuming free play to pursue next objective\". A plan ends\nby its steps completing; this ends the agent.",
      "properties": {
        "kind": {
          "const": "stop",
          "default": "stop",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "StopAction",
      "type": "object"
    },
    "UseGameBindingAction": {
      "additionalProperties": false,
      "description": "Press one named Kenshi control through the shipped-default keymap.\n\nThe agent kept trying to reach screens by hunting for a widget to click -\nclicking the time-speed buttons to unpause, clicking around the world hoping\nan inventory would appear - because nothing in the catalog could simply open\na screen. Kenshi already binds all of this: `I` opens the inventory, `M` the\nmap, `C` the stats window, `Space` pauses under the shipped defaults. Naming\nthe *binding* rather than the key keeps the intention readable and the\ncurrent default mapping in one place; customized keymaps are not yet read.",
      "properties": {
        "kind": {
          "const": "use_game_binding",
          "default": "use_game_binding",
          "title": "Kind",
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/GameBinding"
        },
        "expected_effect": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Expected Effect",
          "type": "string"
        }
      },
      "required": [
        "binding",
        "expected_effect"
      ],
      "title": "UseGameBindingAction",
      "type": "object"
    },
    "WaitAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "wait",
          "default": "wait",
          "title": "Kind",
          "type": "string"
        },
        "seconds": {
          "maximum": 60.0,
          "minimum": 0.0,
          "title": "Seconds",
          "type": "number"
        }
      },
      "required": [
        "seconds"
      ],
      "title": "WaitAction",
      "type": "object"
    },
    "WorldStateRevision": {
      "additionalProperties": false,
      "properties": {
        "telemetry_sequence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Telemetry Sequence"
        },
        "frame_sequence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Sequence"
        },
        "capability_epoch": {
          "default": 0,
          "minimum": 0,
          "title": "Capability Epoch",
          "type": "integer"
        },
        "observed_at_monotonic": {
          "minimum": 0.0,
          "title": "Observed At Monotonic",
          "type": "number"
        }
      },
      "title": "WorldStateRevision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$",
      "title": "Plan Id",
      "type": "string"
    },
    "based_on_plan_version": {
      "minimum": 1,
      "title": "Based On Plan Version",
      "type": "integer"
    },
    "based_on_revision": {
      "$ref": "#/$defs/WorldStateRevision"
    },
    "interrupt_active_step_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Interrupt Active Step Id"
    },
    "replace_future_steps": {
      "items": {
        "$ref": "#/$defs/PlanStep"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Replace Future Steps",
      "type": "array"
    },
    "rationale": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "memory_writes": {
      "items": {
        "$ref": "#/$defs/MemoryWrite"
      },
      "maxItems": 6,
      "title": "Memory Writes",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "based_on_plan_version",
    "based_on_revision",
    "replace_future_steps",
    "rationale"
  ],
  "title": "PlanPatch",
  "type": "object"
}
