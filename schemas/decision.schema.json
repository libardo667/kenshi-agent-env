{
  "$defs": {
    "ActionOutcomeEvidence": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "action_outcome",
          "default": "action_outcome",
          "title": "Source",
          "type": "string"
        },
        "outcome_id": {
          "pattern": "^ao-[1-9][0-9]{0,8}$",
          "title": "Outcome Id",
          "type": "string"
        }
      },
      "required": [
        "outcome_id"
      ],
      "title": "ActionOutcomeEvidence",
      "type": "object"
    },
    "ActivateVisibleControlAction": {
      "additionalProperties": false,
      "description": "Activate exactly one control the interface currently advertises.\n\nThe arguments are an exact current label and role, not coordinates: the\nbounds come from telemetry and are re-resolved inside the input lease. The\naction knows nothing about which screen, which conversation, or which option\nindex it is activating.",
      "properties": {
        "kind": {
          "const": "activate_visible_control",
          "default": "activate_visible_control",
          "title": "Kind",
          "type": "string"
        },
        "exact_label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Exact Label",
          "type": "string"
        },
        "role": {
          "default": "button",
          "enum": [
            "button",
            "text",
            "item"
          ],
          "title": "Role",
          "type": "string"
        },
        "window": {
          "default": "",
          "maxLength": 200,
          "title": "Window",
          "type": "string"
        }
      },
      "required": [
        "exact_label"
      ],
      "title": "ActivateVisibleControlAction",
      "type": "object"
    },
    "AdvisorBriefEvidence": {
      "additionalProperties": false,
      "description": "Advice, not world evidence. Rendered as such wherever it is stored.",
      "properties": {
        "source": {
          "const": "advisor_brief",
          "default": "advisor_brief",
          "title": "Source",
          "type": "string"
        },
        "brief_id": {
          "pattern": "^advisor-[0-9a-f]{32}$",
          "title": "Brief Id",
          "type": "string"
        }
      },
      "required": [
        "brief_id"
      ],
      "title": "AdvisorBriefEvidence",
      "type": "object"
    },
    "AdvisorFocus": {
      "enum": [
        "next_goal",
        "survival",
        "food",
        "economy",
        "recruitment",
        "travel",
        "recovery"
      ],
      "title": "AdvisorFocus",
      "type": "string"
    },
    "AppendFieldbookEntryOperation": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "append_entry",
          "default": "append_entry",
          "title": "Operation",
          "type": "string"
        },
        "project_id": {
          "pattern": "^fbp-[0-9a-f]{32}$",
          "title": "Project Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FieldbookEntryKind"
        },
        "content": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "references": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/CurrentObservationEvidence"
              },
              {
                "$ref": "#/$defs/ActionOutcomeEvidence"
              },
              {
                "$ref": "#/$defs/PlanOutcomeEvidence"
              },
              {
                "$ref": "#/$defs/MemoryEvidence"
              },
              {
                "$ref": "#/$defs/AdvisorBriefEvidence"
              }
            ]
          },
          "maxItems": 4,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "project_id",
        "kind",
        "content"
      ],
      "title": "AppendFieldbookEntryOperation",
      "type": "object"
    },
    "ApproachDialogueTargetAction": {
      "additionalProperties": false,
      "description": "Initiate dialogue with one exact currently observed dialogue target.\n\nReusable and target-generic: the target is any current non-hostile person\nthe telemetry already reports as talkable, vendor or not. The action names\nonly a stable observed identity, never a role, a scenario, or a coordinate.\nThe controller issues Kenshi's native talk-to order and owns the whole\nmonitored interaction, so there is no planner-visible \"continue\napproaching\" or prerequisite unpause command.",
      "properties": {
        "kind": {
          "const": "approach_dialogue_target",
          "default": "approach_dialogue_target",
          "title": "Kind",
          "type": "string"
        },
        "target_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id"
      ],
      "title": "ApproachDialogueTargetAction",
      "type": "object"
    },
    "CameraRotationDirection": {
      "enum": [
        "left",
        "right"
      ],
      "title": "CameraRotationDirection",
      "type": "string"
    },
    "CommandWorldTargetAction": {
      "additionalProperties": false,
      "description": "Right-click one exact current world target at telemetry-owned geometry.",
      "properties": {
        "kind": {
          "const": "command_world_target",
          "default": "command_world_target",
          "title": "Kind",
          "type": "string"
        },
        "target_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "context_action": {
          "$ref": "#/$defs/ContextActionKind"
        }
      },
      "required": [
        "target_id",
        "context_action"
      ],
      "title": "CommandWorldTargetAction",
      "type": "object"
    },
    "ConsultAdvisorAction": {
      "additionalProperties": false,
      "description": "Ask a read-only guide-grounded model for strategic advice.\n\nThis is a cognitive action. It emits no controller primitives, never enters\nthe environment dispatch path, and cannot directly change Kenshi state.",
      "properties": {
        "kind": {
          "const": "consult_advisor",
          "default": "consult_advisor",
          "title": "Kind",
          "type": "string"
        },
        "question": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "focus": {
          "$ref": "#/$defs/AdvisorFocus",
          "default": "next_goal"
        }
      },
      "required": [
        "question"
      ],
      "title": "ConsultAdvisorAction",
      "type": "object"
    },
    "ContextActionKind": {
      "description": "A reviewed semantic action an exact world object accepts as an attempt.",
      "enum": [
        "operate"
      ],
      "title": "ContextActionKind",
      "type": "string"
    },
    "CreateFieldbookProjectOperation": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "create_project",
          "default": "create_project",
          "title": "Operation",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FieldbookProjectKind"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "title",
        "summary"
      ],
      "title": "CreateFieldbookProjectOperation",
      "type": "object"
    },
    "CurrentObservationEvidence": {
      "additionalProperties": false,
      "description": "The exact observation the planner was looking at when it wrote this.",
      "properties": {
        "source": {
          "const": "current_observation",
          "default": "current_observation",
          "title": "Source",
          "type": "string"
        }
      },
      "title": "CurrentObservationEvidence",
      "type": "object"
    },
    "DismissScreenAction": {
      "additionalProperties": false,
      "description": "Close one bound inventory or trade window toward the world view.\n\nExiting is as much a part of using an interface as entering it. Naming the\nscreen and, where applicable, the owner window makes the action bind to\nobserved state instead of blindly pressing a key and hoping. It deliberately\ndoes not end an active conversation: Kenshi's Escape opens the ESC menu, so\ndialogue must choose an exact visible closing reply.",
      "properties": {
        "kind": {
          "const": "dismiss_screen",
          "default": "dismiss_screen",
          "title": "Kind",
          "type": "string"
        },
        "expected_screen": {
          "enum": [
            "dialogue",
            "trade",
            "inventory"
          ],
          "title": "Expected Screen",
          "type": "string"
        },
        "window": {
          "default": "",
          "maxLength": 200,
          "title": "Window",
          "type": "string"
        }
      },
      "required": [
        "expected_screen"
      ],
      "title": "DismissScreenAction",
      "type": "object"
    },
    "EquipItemAction": {
      "additionalProperties": false,
      "description": "Equip the item in one cell of the selected character's own inventory.\n\nKenshi equips on right-click (`rightClickAutoEquipping`) - the *same*\ngesture that sells an item when a trade is open. That collision is the whole\nhazard: an equip attempted with a shop window up is a sale, and the item is\ngone before any postcondition could notice. So this action refuses outright\nunless no trade is active.",
      "properties": {
        "kind": {
          "const": "equip_item",
          "default": "equip_item",
          "title": "Kind",
          "type": "string"
        },
        "cell_label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Cell Label",
          "type": "string"
        },
        "item_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Item Name",
          "type": "string"
        },
        "window": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Window",
          "type": "string"
        }
      },
      "required": [
        "cell_label",
        "item_name",
        "window"
      ],
      "title": "EquipItemAction",
      "type": "object"
    },
    "ExitCurrentBuildingAction": {
      "additionalProperties": false,
      "description": "Leave the selected character's current building through a native door.\n\nThe planner supplies no coordinates, bearing, door identity, or retry\nstrategy. The native controller resolves an unlocked door from the exact\nbuilding the selected character currently occupies, issues one pathing\norder to its outdoor point, and owns completion or typed failure.",
      "properties": {
        "kind": {
          "const": "exit_current_building",
          "default": "exit_current_building",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "ExitCurrentBuildingAction",
      "type": "object"
    },
    "FieldbookEntryKind": {
      "enum": [
        "note",
        "decision",
        "observation",
        "incident",
        "manifest",
        "route_entry",
        "expense",
        "question"
      ],
      "title": "FieldbookEntryKind",
      "type": "string"
    },
    "FieldbookProjectKind": {
      "enum": [
        "delivery_docket",
        "route_atlas",
        "incident_log",
        "vendor_ledger",
        "equipment_plan",
        "journal",
        "generic"
      ],
      "title": "FieldbookProjectKind",
      "type": "string"
    },
    "FieldbookProjectStatus": {
      "enum": [
        "active",
        "paused",
        "completed",
        "abandoned"
      ],
      "title": "FieldbookProjectStatus",
      "type": "string"
    },
    "GameBinding": {
      "description": "Kenshi's named control intentions under the shipped default keymap.\n\nThe current physical mapping is a hard-coded copy of the shipped\n`controls.cfg`; it is not read from the user's active keymap. Membership is\nthe planner-visible subset recorded by the game-binding parity ledger.",
      "enum": [
        "toggle_inventory",
        "toggle_map",
        "toggle_stats",
        "toggle_help",
        "toggle_crafting",
        "toggle_research",
        "quicksave",
        "quickload",
        "build_apply",
        "build_move_down",
        "build_move_up",
        "build_rotate_left",
        "build_rotate_right",
        "build_tilt_decrease",
        "build_tilt_increase",
        "build_undo",
        "pause",
        "speed_1",
        "speed_2",
        "speed_3",
        "camera_forward",
        "camera_back",
        "camera_left",
        "camera_right",
        "camera_rotate_left",
        "camera_rotate_right",
        "camera_tilt+",
        "camera_tilt-",
        "camera_zoom_in",
        "camera_zoom_out",
        "cycle_run_speed",
        "editor_delete",
        "editor_toggle",
        "floor_down",
        "floor_up",
        "gizmo_move",
        "gizmo_rotate",
        "gizmo_scale",
        "focus_char",
        "highlight",
        "select_all",
        "change_squad",
        "character_next",
        "character_prev",
        "select_0",
        "select_1",
        "select_2",
        "select_3",
        "select_4",
        "select_5",
        "select_6",
        "select_7",
        "select_8",
        "select_9",
        "stop_movement",
        "medic",
        "rescue",
        "toggle_hold",
        "toggle_block",
        "toggle_bar"
      ],
      "title": "GameBinding",
      "type": "string"
    },
    "KeepMemoryOperation": {
      "additionalProperties": false,
      "description": "Create one durable record from something already established.\n\n`evidence` is absent on purpose. The stored grounding string is rendered by\nthe runtime from `references` after each one resolves, so a record can\nnever describe proof it does not have.",
      "properties": {
        "operation": {
          "const": "keep",
          "default": "keep",
          "title": "Operation",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MemoryKind"
        },
        "content": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "salience": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Salience",
          "type": "number"
        },
        "target_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "references": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/CurrentObservationEvidence"
              },
              {
                "$ref": "#/$defs/ActionOutcomeEvidence"
              },
              {
                "$ref": "#/$defs/PlanOutcomeEvidence"
              },
              {
                "$ref": "#/$defs/MemoryEvidence"
              },
              {
                "$ref": "#/$defs/AdvisorBriefEvidence"
              }
            ]
          },
          "maxItems": 4,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "content"
      ],
      "title": "KeepMemoryOperation",
      "type": "object"
    },
    "MemoryEvidence": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "memory",
          "default": "memory",
          "title": "Source",
          "type": "string"
        },
        "memory_id": {
          "pattern": "^mem-[A-Za-z0-9]{1,72}$",
          "title": "Memory Id",
          "type": "string"
        }
      },
      "required": [
        "memory_id"
      ],
      "title": "MemoryEvidence",
      "type": "object"
    },
    "MemoryKind": {
      "enum": [
        "fact",
        "episode",
        "commitment",
        "hypothesis"
      ],
      "title": "MemoryKind",
      "type": "string"
    },
    "MemoryResolutionDisposition": {
      "description": "What resolving an intention or uncertainty actually concluded.",
      "enum": [
        "completed",
        "abandoned",
        "confirmed",
        "rejected",
        "unknown"
      ],
      "title": "MemoryResolutionDisposition",
      "type": "string"
    },
    "MoveInDirectionAction": {
      "additionalProperties": false,
      "description": "Walk a bearing and a distance from wherever the character is standing.\n\nThe intended destination is a point, not a person, so this action models\nmovement even when no nearby character can serve as a destination. Its\nnative request and acknowledgement deliberately carry an empty target ID;\ncommand identity is the keyed command, selected character, bearing, and\ndistance.\n\n`bearing_degrees` is clockwise from north, as read on the map: 0 north,\n90 east, 180 south, 270 west.",
      "properties": {
        "kind": {
          "const": "move_in_direction",
          "default": "move_in_direction",
          "title": "Kind",
          "type": "string"
        },
        "bearing_degrees": {
          "exclusiveMaximum": 360.0,
          "minimum": 0.0,
          "title": "Bearing Degrees",
          "type": "number"
        },
        "distance_units": {
          "exclusiveMinimum": 0.0,
          "maximum": 2000.0,
          "title": "Distance Units",
          "type": "number"
        },
        "expected_effect": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Expected Effect",
          "type": "string"
        }
      },
      "required": [
        "bearing_degrees",
        "distance_units",
        "expected_effect"
      ],
      "title": "MoveInDirectionAction",
      "type": "object"
    },
    "MoveToCharacterAction": {
      "additionalProperties": false,
      "description": "Walk to any exact observed nearby character without talking to them.\n\nMovement used to be possible only toward someone the agent could hold a\nconversation with, so inside a building holding two people that was the\nwhole reachable world: it sold what it could, asked both for work, recorded\nthat it was repeating itself, and had no action that could take it\nanywhere. Nearby characters are reported within four hundred units, which\nacross a town is most of it, so walking to a person is how the agent gets\nto a place - the destination is a stable observed identity, never a\ncoordinate.",
      "properties": {
        "kind": {
          "const": "move_to_character",
          "default": "move_to_character",
          "title": "Kind",
          "type": "string"
        },
        "target_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id"
      ],
      "title": "MoveToCharacterAction",
      "type": "object"
    },
    "NoopAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "noop",
          "default": "noop",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "default": "No action required.",
          "title": "Reason",
          "type": "string"
        }
      },
      "title": "NoopAction",
      "type": "object"
    },
    "PauseAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pause",
          "default": "pause",
          "title": "Kind",
          "type": "string"
        },
        "paused": {
          "default": true,
          "title": "Paused",
          "type": "boolean"
        }
      },
      "title": "PauseAction",
      "type": "object"
    },
    "PlanOutcomeEvidence": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "plan_outcome",
          "default": "plan_outcome",
          "title": "Source",
          "type": "string"
        },
        "plan_outcome_id": {
          "pattern": "^po-[1-9][0-9]{0,8}$",
          "title": "Plan Outcome Id",
          "type": "string"
        }
      },
      "required": [
        "plan_outcome_id"
      ],
      "title": "PlanOutcomeEvidence",
      "type": "object"
    },
    "PurchaseItemAction": {
      "additionalProperties": false,
      "description": "Buy a bounded quantity of one item from exact seller-owned cells.\n\nCurrent producers name the cell and item directly. `expected_price` carries\nthe best current value estimate for optional spending gates, but the\nexported `item_value` is base worth rather than an authoritative final shop\ncharge. The model chooses the useful quantity once. The controller rebinds\ninterchangeable stock after each transfer and proves both money loss and\ncarried-item gain before attempting the next unit.",
      "properties": {
        "kind": {
          "const": "purchase_item",
          "default": "purchase_item",
          "title": "Kind",
          "type": "string"
        },
        "cell_label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Cell Label",
          "type": "string"
        },
        "item_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Item Name",
          "type": "string"
        },
        "expected_price": {
          "exclusiveMinimum": 0,
          "title": "Expected Price",
          "type": "integer"
        },
        "quantity": {
          "default": 1,
          "maximum": 5,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "window": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Window",
          "type": "string"
        },
        "seller_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Seller Id",
          "type": "string"
        }
      },
      "required": [
        "cell_label",
        "item_name",
        "expected_price",
        "window",
        "seller_id"
      ],
      "title": "PurchaseItemAction",
      "type": "object"
    },
    "ReadFieldbookAction": {
      "additionalProperties": false,
      "description": "Electively inspect bounded private project context without game input.",
      "properties": {
        "kind": {
          "const": "read_fieldbook",
          "default": "read_fieldbook",
          "title": "Kind",
          "type": "string"
        },
        "project_id": {
          "anyOf": [
            {
              "pattern": "^fbp-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "max_entries": {
          "default": 4,
          "maximum": 8,
          "minimum": 1,
          "title": "Max Entries",
          "type": "integer"
        }
      },
      "title": "ReadFieldbookAction",
      "type": "object"
    },
    "RecallMemoryAction": {
      "additionalProperties": false,
      "description": "Deliberately read continuity beyond what automatic context already showed.\n\nA cognitive action. It emits no controller primitives, never enters the\nenvironment dispatch path, spends no pointer, purchase, or native risk\nbudget, and cannot authorize anything. Durable memory searches active\nrecords; working-outcome searches resurface compact runtime-owned evidence\nthat scrolled out of the rich recent window.",
      "properties": {
        "kind": {
          "const": "recall_memory",
          "default": "recall_memory",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "default": "durable_memory",
          "enum": [
            "durable_memory",
            "working_outcomes"
          ],
          "title": "Source",
          "type": "string"
        },
        "query": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "max_records": {
          "default": 4,
          "maximum": 8,
          "minimum": 1,
          "title": "Max Records",
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "title": "RecallMemoryAction",
      "type": "object"
    },
    "RecoverCameraViewAction": {
      "additionalProperties": false,
      "description": "Ask the controller to restore a usable character-following world view.\n\nThis action intentionally has no camera parameters. The caller identifies\nthe problem; the controller owns the bounded follow, floor, zoom, orbit,\ncapture, and scoring transaction and reports its terminal outcome.",
      "properties": {
        "kind": {
          "const": "recover_camera_view",
          "default": "recover_camera_view",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "RecoverCameraViewAction",
      "type": "object"
    },
    "ReinforceMemoryOperation": {
      "additionalProperties": false,
      "description": "Say an existing record still matters, without writing a second copy.",
