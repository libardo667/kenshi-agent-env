    "SetSpeedAction": {
      "additionalProperties": false,
      "description": "Set a running playback state at one of Kenshi's three ordinal gears.\n\nThis is one semantic transition even when Kenshi is paused. The controller\nowns starting at gear 1 before selecting a faster gear, because the faster\nkeys do not themselves resume a paused world.",
      "properties": {
        "kind": {
          "const": "set_speed",
          "default": "set_speed",
          "title": "Kind",
