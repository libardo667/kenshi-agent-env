{
  "$defs": {
    "ActivateVisibleControlAction": {
      "additionalProperties": false,
      "description": "Activate exactly one control the interface currently advertises.\n\nThe arguments are an exact current label and role, not coordinates: the\nbounds come from telemetry and are re-resolved inside the input lease. The\naction knows nothing about which screen, which conversation, or which option\nindex it is activating.",
      "properties": {
        "kind": {
          "const": "activate_visible_control",
          "default": "activate_visible_control",
          "title": "Kind",
          "type": "string"
        },
        "exact_label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Exact Label",
          "type": "string"
        },
        "role": {
          "default": "button",
          "enum": [
            "button",
            "text"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "exact_label"
      ],
      "title": "ActivateVisibleControlAction",
      "type": "object"
    },
    "ApproachDialogueTargetAction": {
      "additionalProperties": false,
      "description": "Walk to one exact currently observed dialogue target and open dialogue.\n\nReusable and target-generic: the target is any current non-hostile person\nthe telemetry already reports as talkable, vendor or not. The action names\nonly a stable observed identity, never a role, a scenario, or a coordinate.\nOne monitored option owns the whole walk, so there is no planner-visible\n\"continue approaching\" command.",
      "properties": {
        "kind": {
          "const": "approach_dialogue_target",
          "default": "approach_dialogue_target",
          "title": "Kind",
          "type": "string"
        },
        "target_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id"
      ],
      "title": "ApproachDialogueTargetAction",
      "type": "object"
    },
    "ClickAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "click",
          "default": "click",
          "title": "Kind",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "space": {
          "$ref": "#/$defs/CoordinateSpace",
          "default": "normalized"
        },
        "button": {
          "$ref": "#/$defs/MouseButton",
          "default": "left"
        },
        "clicks": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Clicks",
          "type": "integer"
        },
        "hold_seconds": {
          "default": 0.0,
          "maximum": 0.5,
          "minimum": 0.0,
          "title": "Hold Seconds",
          "type": "number"
        },
        "interval_seconds": {
          "default": 0.08,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Interval Seconds",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "ClickAction",
      "type": "object"
    },
    "CoordinateSpace": {
      "enum": [
        "normalized",
        "client",
        "screen"
      ],
      "title": "CoordinateSpace",
      "type": "string"
    },
    "DismissScreenAction": {
      "additionalProperties": false,
      "description": "Close the screen that is currently open, back toward the world view.\n\nExiting is as much a part of using an interface as entering it, and it was\nthe one step with no reusable action: the calibrated path pressed Escape,\na raw key the generic surface rejects for good reason. Naming the screen the\nplanner believes is open makes the action bind to observed state instead of\nblindly pressing a key and hoping.",
      "properties": {
        "kind": {
          "const": "dismiss_screen",
          "default": "dismiss_screen",
          "title": "Kind",
          "type": "string"
        },
        "expected_screen": {
          "enum": [
            "dialogue",
            "trade",
            "inventory"
          ],
          "title": "Expected Screen",
          "type": "string"
        }
      },
      "required": [
        "expected_screen"
      ],
      "title": "DismissScreenAction",
      "type": "object"
    },
    "HotkeyAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "hotkey",
          "default": "hotkey",
          "title": "Kind",
          "type": "string"
        },
        "keys": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 2,
          "title": "Keys",
          "type": "array"
        },
        "hold_seconds": {
          "default": 0.04,
          "maximum": 5.0,
          "minimum": 0.0,
          "title": "Hold Seconds",
          "type": "number"
        }
      },
      "required": [
        "keys"
      ],
      "title": "HotkeyAction",
      "type": "object"
    },
    "KeyAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "key",
          "default": "key",
          "title": "Kind",
          "type": "string"
        },
        "key": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "hold_seconds": {
          "default": 0.04,
          "maximum": 5.0,
          "minimum": 0.0,
          "title": "Hold Seconds",
          "type": "number"
        }
      },
      "required": [
        "key"
      ],
      "title": "KeyAction",
      "type": "object"
    },
    "MemoryKind": {
      "enum": [
        "fact",
        "episode",
        "commitment",
        "hypothesis"
      ],
      "title": "MemoryKind",
      "type": "string"
    },
    "MemoryWrite": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/MemoryKind"
        },
        "content": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "salience": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Salience",
          "type": "number"
        },
        "evidence": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        }
      },
      "required": [
        "kind",
        "content"
      ],
      "title": "MemoryWrite",
      "type": "object"
    },
    "MouseButton": {
      "enum": [
        "left",
        "right",
        "middle"
      ],
      "title": "MouseButton",
      "type": "string"
    },
    "MoveCursorAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "move_cursor",
          "default": "move_cursor",
          "title": "Kind",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "space": {
          "$ref": "#/$defs/CoordinateSpace",
          "default": "normalized"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "MoveCursorAction",
      "type": "object"
    },
    "NoopAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "noop",
          "default": "noop",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "default": "No action required.",
          "title": "Reason",
          "type": "string"
        }
      },
      "title": "NoopAction",
      "type": "object"
    },
    "PauseAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pause",
          "default": "pause",
          "title": "Kind",
          "type": "string"
        },
        "paused": {
          "default": true,
          "title": "Paused",
          "type": "boolean"
        }
      },
      "title": "PauseAction",
      "type": "object"
    },
    "ScrollAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "scroll",
          "default": "scroll",
          "title": "Kind",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "space": {
          "$ref": "#/$defs/CoordinateSpace",
          "default": "normalized"
        },
        "notches": {
          "maximum": 8,
          "minimum": -8,
          "title": "Notches",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "notches"
      ],
      "title": "ScrollAction",
      "type": "object"
    },
    "SetSpeedAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "set_speed",
          "default": "set_speed",
          "title": "Kind",
          "type": "string"
        },
        "speed": {
          "enum": [
            1,
            2,
            3
          ],
          "title": "Speed",
          "type": "integer"
        }
      },
      "required": [
        "speed"
      ],
      "title": "SetSpeedAction",
      "type": "object"
    },
    "SkillAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "skill",
          "default": "skill",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "args": {
          "items": {
            "$ref": "#/$defs/SkillArgument"
          },
          "maxItems": 20,
          "title": "Args",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "SkillAction",
      "type": "object"
    },
    "SkillArgument": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "SkillArgument",
      "type": "object"
    },
    "StopAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "stop",
          "default": "stop",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "StopAction",
      "type": "object"
    },
    "WaitAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "wait",
          "default": "wait",
          "title": "Kind",
          "type": "string"
        },
        "seconds": {
          "maximum": 60.0,
          "minimum": 0.0,
          "title": "Seconds",
          "type": "number"
        }
      },
      "required": [
        "seconds"
      ],
      "title": "WaitAction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "intent": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Intent",
      "type": "string"
    },
    "rationale": {
      "maxLength": 1500,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "action": {
      "anyOf": [
        {
          "$ref": "#/$defs/NoopAction"
        },
        {
          "$ref": "#/$defs/StopAction"
        },
        {
          "$ref": "#/$defs/PauseAction"
        },
        {
          "$ref": "#/$defs/SetSpeedAction"
        },
        {
          "$ref": "#/$defs/WaitAction"
        },
        {
          "$ref": "#/$defs/KeyAction"
        },
        {
          "$ref": "#/$defs/HotkeyAction"
        },
        {
          "$ref": "#/$defs/MoveCursorAction"
        },
        {
          "$ref": "#/$defs/ClickAction"
        },
        {
          "$ref": "#/$defs/ScrollAction"
        },
        {
          "$ref": "#/$defs/SkillAction"
        },
        {
          "$ref": "#/$defs/ApproachDialogueTargetAction"
        },
        {
          "$ref": "#/$defs/ActivateVisibleControlAction"
        },
        {
          "$ref": "#/$defs/DismissScreenAction"
        }
      ],
      "title": "Action"
    },
    "confidence": {
      "default": 0.5,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "expected_observation": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Observation"
    },
    "memory_writes": {
      "items": {
        "$ref": "#/$defs/MemoryWrite"
      },
      "maxItems": 6,
      "title": "Memory Writes",
      "type": "array"
    }
  },
  "required": [
    "intent",
    "rationale",
    "action"
  ],
  "title": "PlannerDecision",
  "type": "object"
}
