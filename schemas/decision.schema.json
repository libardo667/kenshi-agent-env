    "UseGameBindingAction": {
      "additionalProperties": false,
      "description": "Press one named Kenshi control through the shipped-default keymap.\n\nThe agent kept trying to reach screens by hunting for a widget to click -\nclicking the time-speed buttons to unpause, clicking around the world hoping\nan inventory would appear - because nothing in the catalog could simply open\na screen. Kenshi already binds all of this: `I` opens the inventory, `M` the\nmap and `C` the stats window under the shipped defaults. Naming\nthe *binding* rather than the key keeps the intention readable and the\ncurrent default mapping in one place; customized keymaps are not yet read.\nThe binding enum is the semantic vocabulary, rather than an escape hatch to\narbitrary keys. Time keys remain controller details behind PauseAction and\nSetSpeedAction.",
      "properties": {
        "kind": {
          "const": "use_game_binding",
          "default": "use_game_binding",
          "title": "Kind",
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/GameBinding"
        },
        "expected_effect": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Expected Effect",
          "type": "string"
        }
      },
      "required": [
        "binding",
        "expected_effect"
      ],
      "title": "UseGameBindingAction",
      "type": "object"
    },
