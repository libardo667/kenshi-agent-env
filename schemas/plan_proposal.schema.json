{
  "$defs": {
    "AffordanceParameter": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "AffordanceParameter",
      "type": "object"
    },
    "AffordanceSelection": {
      "additionalProperties": false,
      "description": "The entire game-action language exposed to the playing model.\n\nA choice is named by what it means, not by an opaque handle. The handle\nremains for runtime provenance and is accepted when a caller has one, but a\nplaying model is never required to reproduce it.\n\nThat requirement was a real failure mode rather than a theoretical one: a\nlive run stopped at step zero three times over because the model emitted\n`aff-9f556b8eaba80dbfd68c`, a plausible twenty-hex-character id that had\nnever existed in any observation. Every other field it emits is meaningful\nand it gets those right; a hash is the one thing it cannot check itself\nagainst, and an invented one is indistinguishable from a remembered one.",
      "properties": {
        "semantic": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Semantic",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/AffordanceParameter"
          },
          "maxItems": 8,
          "title": "Parameters",
          "type": "array"
        }
      },
      "required": [
        "semantic"
      ],
      "title": "AffordanceSelection",
      "type": "object"
    },
    "ContinuityProposal": {
      "additionalProperties": false,
      "description": "A memory transition proposal using evidence IDs, not tagged ID wrappers.",
      "properties": {
        "operation": {
          "enum": [
            "keep",
            "reinforce",
            "resolve",
            "supersede",
            "retract"
          ],
          "title": "Operation",
          "type": "string"
        },
        "memory_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Id"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "disposition": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryResolutionDisposition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "salience": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Salience"
        },
        "target_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "operation"
      ],
      "title": "ContinuityProposal",
      "type": "object"
    },
    "FieldbookEntryKind": {
      "enum": [
        "note",
        "decision",
        "observation",
        "incident",
        "manifest",
        "route_entry",
        "expense",
        "question"
      ],
      "title": "FieldbookEntryKind",
      "type": "string"
    },
    "FieldbookProjectKind": {
      "enum": [
        "delivery_docket",
        "route_atlas",
        "incident_log",
        "vendor_ledger",
        "equipment_plan",
        "journal",
        "generic"
      ],
      "title": "FieldbookProjectKind",
      "type": "string"
    },
    "FieldbookProjectStatus": {
      "enum": [
        "active",
        "paused",
        "completed",
        "abandoned"
      ],
      "title": "FieldbookProjectStatus",
      "type": "string"
    },
    "FieldbookProposal": {
      "additionalProperties": false,
      "description": "A private-project transition proposal with runtime-resolved evidence.",
      "properties": {
        "operation": {
          "enum": [
            "create_project",
            "append_entry",
            "update_summary",
            "select_project",
            "set_project_status"
          ],
          "title": "Operation",
          "type": "string"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldbookProjectKind"
            },
            {
              "$ref": "#/$defs/FieldbookEntryKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldbookProjectStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "operation"
      ],
      "title": "FieldbookProposal",
      "type": "object"
    },
    "JsonValue": {},
    "MemoryKind": {
      "enum": [
        "fact",
        "episode",
        "commitment",
        "hypothesis"
      ],
      "title": "MemoryKind",
      "type": "string"
    },
    "MemoryResolutionDisposition": {
      "description": "What resolving an intention or uncertainty actually concluded.",
      "enum": [
        "completed",
        "abandoned",
        "confirmed",
        "rejected",
        "unknown"
      ],
      "title": "MemoryResolutionDisposition",
      "type": "string"
    },
    "ProposedPlanStep": {
      "additionalProperties": false,
      "description": "One exact current affordance, without executor bookkeeping.",
      "properties": {
        "selection": {
          "$ref": "#/$defs/AffordanceSelection"
        }
      },
      "required": [
        "selection"
      ],
      "title": "ProposedPlanStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One hosted choice; deterministic code observes again before another.",
  "properties": {
    "objective": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/ProposedPlanStep"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "continuity_operations": {
      "items": {
        "$ref": "#/$defs/ContinuityProposal"
      },
      "maxItems": 6,
      "title": "Continuity Operations",
      "type": "array"
    },
    "fieldbook_operations": {
      "items": {
        "$ref": "#/$defs/FieldbookProposal"
      },
      "maxItems": 4,
      "title": "Fieldbook Operations",
      "type": "array"
    }
  },
  "required": [
    "objective",
    "steps"
  ],
  "title": "PlanProposal",
  "type": "object"
}
