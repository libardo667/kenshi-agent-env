#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ $# -eq 0 ]]; then
  echo "usage: ./dev {launch|graphics|shot|telemetry|journey} [options]" >&2
  exit 2
fi

command_name="$1"
shift
case "$command_name" in
  launch|graphics|shot|telemetry)
    config_path="$repo_dir/config/live.burnin.yaml"
    ;;
  journey)
    config_path="$repo_dir/config/live.longform.yaml"
    ;;
  *)
    echo "unknown ./dev command: $command_name" >&2
    exit 2
    ;;
esac

to_windows_path() {
  local candidate="$1"
  case "$candidate" in
    [A-Za-z]:[\\/]*|\\\\*)
      printf '%s\n' "$candidate"
      ;;
    /*)
      wslpath -w "$candidate"
      ;;
    *)
      wslpath -w "$repo_dir/$candidate"
      ;;
  esac
}

forward_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --config)
      if [[ $# -lt 2 ]]; then
        echo "--config requires a path" >&2
        exit 2
      fi
      config_path="$2"
      shift 2
      ;;
    --config=*)
      config_path="${1#--config=}"
      shift
      ;;
    --planner-script)
      if [[ $# -lt 2 ]]; then
        echo "--planner-script requires a path" >&2
        exit 2
      fi
      forward_args+=("--planner-script" "$(to_windows_path "$2")")
      shift 2
      ;;
    --planner-script=*)
      forward_args+=(
        "--planner-script"
        "$(to_windows_path "${1#--planner-script=}")"
      )
      shift
      ;;
    *)
      forward_args+=("$1")
      shift
      ;;
  esac
done

windows_config="$(to_windows_path "$config_path")"
windows_local_app_data="$(powershell.exe -NoProfile -Command '[Environment]::GetFolderPath("LocalApplicationData")' | tr -d '\r')"
windows_python="$(wslpath "$windows_local_app_data")/KenshiAgent/venvs/kenshi-agent-env/Scripts/python.exe"

if [[ ! -x "$windows_python" ]]; then
  echo "Windows live Python was not found at $windows_python" >&2
  exit 1
fi

# WSL does not forward arbitrary per-command variables to Windows executables.
# Keep the live override surface explicit, and pass only variables the checked-in
# profiles intentionally consume. Values stay out of command lines and logs.
runtime_overrides=(
  KENSHI_AGENT_OPENROUTER_MODEL
  KENSHI_AGENT_REASONING_EFFORT
  KENSHI_AGENT_ADVISOR_MODEL
  KENSHI_AGENT_ADVISOR_REASONING_EFFORT
  KENSHI_AGENT_ADVISOR_CADENCE_STEPS
)
for variable_name in "${runtime_overrides[@]}"; do
  if [[ -n "${!variable_name+x}" ]]; then
    export WSLENV="${WSLENV:+${WSLENV}:}${variable_name}/w"
  fi
done

cd "$repo_dir"
exec "$windows_python" -m kenshi_agent.live_dev \
  "$command_name" \
  --config "$windows_config" \
  "${forward_args[@]}"
