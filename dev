#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ $# -eq 0 ]]; then
  echo "usage: ./dev {launch|play|close|recover|crash|graphics|shot|telemetry|scenario|journey} [options]" >&2
  exit 2
fi

command_name="$1"
shift
case "$command_name" in
  launch|close|recover|crash|graphics|shot|telemetry|scenario)
    config_path="$repo_dir/config/live.burnin.yaml"
    ;;
  journey|play)
    config_path="$repo_dir/config/live.longform.yaml"
    ;;
  *)
    echo "unknown ./dev command: $command_name" >&2
    exit 2
    ;;
esac

to_windows_path() {
  local candidate="$1"
  case "$candidate" in
    [A-Za-z]:[\\/]*|\\\\*)
      printf '%s\n' "$candidate"
      ;;
    /*)
      wslpath -w "$candidate"
      ;;
    *)
      wslpath -w "$repo_dir/$candidate"
      ;;
  esac
}

forward_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --config)
      if [[ $# -lt 2 ]]; then
        echo "--config requires a path" >&2
        exit 2
      fi
      config_path="$2"
      shift 2
      ;;
    --config=*)
      config_path="${1#--config=}"
      shift
      ;;
    --planner-script)
      if [[ $# -lt 2 ]]; then
        echo "--planner-script requires a path" >&2
        exit 2
      fi
      forward_args+=("--planner-script" "$(to_windows_path "$2")")
      shift 2
      ;;
    --planner-script=*)
      forward_args+=(
        "--planner-script"
        "$(to_windows_path "${1#--planner-script=}")"
      )
      shift
      ;;
    *)
      forward_args+=("$1")
      shift
      ;;
  esac
done

windows_config="$(to_windows_path "$config_path")"
windows_local_app_data="$(powershell.exe -NoProfile -Command '[Environment]::GetFolderPath("LocalApplicationData")' | tr -d '\r')"
windows_python="$(wslpath "$windows_local_app_data")/KenshiAgent/venvs/kenshi-agent-env/Scripts/python.exe"

if [[ ! -x "$windows_python" ]]; then
  echo "Windows live Python was not found at $windows_python" >&2
  exit 1
fi

# WSL does not forward arbitrary per-command variables to Windows executables.
# Keep the live override surface explicit, and pass only variables the checked-in
# profiles intentionally consume. Values stay out of command lines and logs.
runtime_overrides=(
  KENSHI_AGENT_OPENROUTER_MODEL
  KENSHI_AGENT_REASONING_EFFORT
  KENSHI_AGENT_ADVISOR_MODEL
  KENSHI_AGENT_ADVISOR_REASONING_EFFORT
  KENSHI_AGENT_ADVISOR_CADENCE_STEPS
  WSL_DISTRO_NAME
)
for variable_name in "${runtime_overrides[@]}"; do
  if [[ -n "${!variable_name+x}" ]]; then
    export WSLENV="${WSLENV:+${WSLENV}:}${variable_name}/w"
  fi
done

cd "$repo_dir"
windows_command=(
  "$windows_python"
  -u
  -m
  kenshi_agent.live_dev
  "$command_name"
  --config
  "$windows_config"
  "${forward_args[@]}"
)

windows_stdio_is_terminal() {
  [[ -t 0 || -t 1 || -t 2 ]]
}

run_windows_command() {
  if windows_stdio_is_terminal; then
    # WSL's Windows interop can ask a terminal for its cursor position
    # (ESC[6n) and wait forever for a response. Live tooling has no interactive
    # stdin contract, so make that impossible while retaining streamed output.
    "$@" </dev/null 2>&1 | cat
  else
    "$@"
  fi
}

if [[ "$command_name" != "journey" && "$command_name" != "play" ]]; then
  if windows_stdio_is_terminal; then
    run_windows_command "${windows_command[@]}"
    exit "$?"
  fi
  exec "${windows_command[@]}"
fi

recover_interrupted_journey() {
  local journey_status="$?"
  trap - EXIT INT TERM
  if [[ "$journey_status" -ne 0 ]]; then
    echo "Journey exited before clean completion; running supported recovery." >&2
    run_windows_command "$windows_python" -u -m kenshi_agent.live_dev \
      recover \
      --config "$windows_config" >&2 || true
  fi
  exit "$journey_status"
}

trap recover_interrupted_journey EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
run_windows_command "${windows_command[@]}"
