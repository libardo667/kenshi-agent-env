#!/usr/bin/env python3
"""WSL bootstrap for the supported Windows live-development runtime."""

from __future__ import annotations

import os
import re
import signal
import subprocess
import sys
from io import BufferedReader
from pathlib import Path
from typing import NoReturn

REPO_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(REPO_DIR / "src"))

from kenshi_agent.dev_cli import LIVE_CONFIG, build_parser  # noqa: E402

RUNTIME_OVERRIDES = (
    "KENSHI_AGENT_OPENROUTER_MODEL",
    "KENSHI_AGENT_REASONING_EFFORT",
    "KENSHI_AGENT_ADVISOR_MODEL",
    "KENSHI_AGENT_ADVISOR_REASONING_EFFORT",
    "KENSHI_AGENT_ADVISOR_CADENCE_STEPS",
    "WSL_DISTRO_NAME",
)


class _SignalExit(Exception):
    def __init__(self, status: int) -> None:
        self.status = status
        super().__init__(status)


def _fail(message: str, status: int = 1) -> NoReturn:
    print(message, file=sys.stderr)
    raise SystemExit(status)


def _run_text(*command: str) -> str:
    try:
        result = subprocess.run(
            command,
            check=True,
            capture_output=True,
            text=True,
        )
    except (FileNotFoundError, subprocess.CalledProcessError) as exc:
        _fail(f"Could not prepare the Windows live runtime: {exc}")
    return result.stdout.strip().replace("\r", "")


def _to_windows_path(value: str) -> str:
    if re.match(r"^[A-Za-z]:[\\/]", value) or value.startswith("\\\\"):
        return value
    candidate = Path(value).expanduser()
    if not candidate.is_absolute():
        candidate = REPO_DIR / candidate
    return _run_text("wslpath", "-w", str(candidate))


def _windows_python() -> Path:
    local_app_data = _run_text(
        "powershell.exe",
        "-NoProfile",
        "-Command",
        '[Environment]::GetFolderPath("LocalApplicationData")',
    )
    local_app_data_wsl = _run_text("wslpath", local_app_data)
    executable = (
        Path(local_app_data_wsl)
        / "KenshiAgent"
        / "venvs"
        / "kenshi-agent-env"
        / "Scripts"
        / "python.exe"
    )
    if not executable.is_file() or not os.access(executable, os.X_OK):
        _fail(f"Windows live Python was not found at {executable}")
    return executable


def _forwarded_environment() -> dict[str, str]:
    environment = os.environ.copy()
    entries = [item for item in environment.get("WSLENV", "").split(":") if item]
    for name in RUNTIME_OVERRIDES:
        if name not in environment:
            continue
        entry = f"{name}/w"
        if entry not in entries:
            entries.append(entry)
    if entries:
        environment["WSLENV"] = ":".join(entries)
    return environment


def _windows_argv(raw_argv: list[str]) -> list[str]:
    return [
        "-u",
        "-m",
        "kenshi_agent.live_dev",
        raw_argv[0],
        "--config",
        _to_windows_path(LIVE_CONFIG),
        *raw_argv[1:],
    ]


def _stdio_is_terminal() -> bool:
    return any(stream.isatty() for stream in (sys.stdin, sys.stdout, sys.stderr))


def raise_signal_exit(status: int) -> NoReturn:
    raise _SignalExit(status)


def _run_windows(
    executable: Path,
    argv: list[str],
    *,
    environment: dict[str, str],
) -> int:
    terminal = _stdio_is_terminal()
    process = subprocess.Popen(
        [str(executable), *argv],
        cwd=REPO_DIR,
        env=environment,
        stdin=subprocess.DEVNULL if terminal else None,
        stdout=subprocess.PIPE if terminal else None,
        stderr=subprocess.STDOUT if terminal else None,
    )
    try:
        if terminal:
            assert isinstance(process.stdout, BufferedReader)
            while chunk := process.stdout.read1(4096):
                sys.stdout.buffer.write(chunk)
                sys.stdout.buffer.flush()
        return process.wait()
    finally:
        _terminate_transport_process(process)


def _terminate_transport_process(
    process: subprocess.Popen[bytes],
    *,
    timeout_seconds: float = 2.0,
) -> None:
    """Revoke one Windows transport child before recovery can touch Kenshi."""

    if process.poll() is not None:
        return
    try:
        process.terminate()
        process.wait(timeout=timeout_seconds)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait(timeout=timeout_seconds)
    except OSError:
        if process.poll() is None:
            raise


def main(argv: list[str] | None = None) -> int:
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    args = build_parser().parse_args(raw_argv)
    executable = _windows_python()
    environment = _forwarded_environment()
    windows_argv = _windows_argv(raw_argv)

    try:
        status = _run_windows(executable, windows_argv, environment=environment)
    except KeyboardInterrupt:
        status = 130
    except _SignalExit as exc:
        status = exc.status
    if args.command != "run" or status == 0:
        return status

    print(
        "Agent run exited before clean completion; running supported recovery.",
        file=sys.stderr,
    )
    recovery_argv = [
        "-u",
        "-m",
        "kenshi_agent.live_dev",
        "recover",
        "--config",
        windows_argv[windows_argv.index("--config") + 1],
    ]
    _run_windows(executable, recovery_argv, environment=environment)
    return status


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, lambda _signum, _frame: raise_signal_exit(143))
    raise SystemExit(main())
